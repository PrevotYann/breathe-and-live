Equipement medical","activation":"action","quantity":1,"usageNote":"Soin complet de terrain.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"healing":"1d20","stabilizes":true,"removeConditions":["bleed"],"maxHeal":false},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.items-medical-utility.Item.d795c11f92be4431","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[],"folder":"27193887dd68f9cb","ownership":{"default":0},"sort":600},{"_id":"d3568f726b4d351c","name":"Analgesiques","type":"consumable","img":"icons/consumables/potions/potion-flask-corked-white.webp","system":{"tags":["medical","painkiller","consumable"],"description":"Calme la douleur et aide a tenir debout malgre les blessures.","sourceSection":"Equipement medical","activation":"bonus","quantity":1,"usageNote":"Restaure temporairement un peu d'endurance; ne retire pas les blessures graves ni le cap de soin.","prerequisites":{"class":"","rank":"","breath":"","sense":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"medecine","resultItemName":"","consumedOnFailure":false,"notes":""},"healing":"","enduranceGain":"5","temporaryEndurance":true,"resourceRestore":"Endurance temporaire"},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.items-medical-utility.Item.ecd2bd3716baccf9","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[],"folder":"27193887dd68f9cb","ownership":{"default":0},"sort":700},{"_id":"b8ab7f844eb574fa","name":"Poison de glycine affaiblissant","type":"poison","img":"icons/consumables/potions/bottle-corked-green.webp","system":{"tags":["poison","glycine"],"description":"Dose de poison de glycine destinee a affaiblir progressivement la cible.","sourceSection":"Poison de Glycine","activation":"action","quantity":3,"usageNote":"Enduire une arme prend une action. La cible touchee subit -1 Force et -1 Finesse par niveau de poison a chaque tour.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"potency":1,"profile":"glycineWeakening","damageFormula":"","demonOnly":false,"ignoreMoonDemons":false,"onHitEffects":[],"application":"action"},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.items-medical-utility.Item.999bf320aca48937","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[],"folder":"27193887dd68f9cb","ownership":{"default":0},"sort":800},{"_id":"c7d9dbf94607fba8","name":"Kunai de glycine","type":"projectile","img":"icons/weapons/daggers/dagger-curved-purple.webp","system":{"tags":["projectile"],"description":"","sourceSection":"Livre français — diapositive 94","activation":"action","quantity":1,"usageNote":"","prerequisites":{"class":"","rank":"","breath":"","sense":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"supplement1934":{"enabled":false,"notes":""},"damage":"1d6 + Precision","range":1.5,"category":"projectile","weaponFamily":"projectile","attackMod":0,"damageMod":0,"properties":["lance","glycine","poison"],"usesAmmo":false,"isNichirin":false,"canDecapitate":false,"recoverable":false,"notes":"Applique un poison de glycine si prepare par le MJ.","ruleSource":{"url":"https://docs.google.com/presentation/d/1v8MuzzgndlBA5djtzvsO1-m5RMda2pf02qQ9LYE4N9E/edit","checkedAt":"2026-10-05","missingFields":[],"approved":false,"page":94},"rangeFormula":"1.5 * Force","poisonProfile":"glycineWeakening"},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.items-weapons.Item.fb6f7b0b47f67b86","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[],"folder":"27193887dd68f9cb","ownership":{"default":0},"sort":900},{"_id":"824d3184242a8025","name":"Dango","type":"food","img":"icons/consumables/food/bowl-rice-brown.webp","system":{"description":"Collation sans bonus mécanique ; les préférences des PNJ sont arbitrées par le MJ.","usageNote":"Collation sans bonus mécanique ; les préférences des PNJ sont arbitrées par le MJ. Offerts par Okiku à l'auberge du Saule.","sourceSection":"Livre français — diapositive 105","tags":["rulebook","food"],"activation":"action","quantity":1,"prerequisites":{},"ruleSource":{"url":"https://docs.google.com/presentation/d/1v8MuzzgndlBA5djtzvsO1-m5RMda2pf02qQ9LYE4N9E/edit","checkedAt":"2026-10-05","missingFields":[],"approved":false},"price":4,"enduranceGain":""},"flags":{},"effects":[],"_stats":{"compendiumSource":"Compendium.breathe-and-live.items-medical-utility.Item.7d2676c6fc4e4f51","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"folder":"27193887dd68f9cb","ownership":{"default":0},"sort":1000}],"journal":[{"_id":"bc3c8fdd1a3d5b97","name":"Les Lanternes de Hotaru — Guide du MJ","folder":"401475af84dabdb1","sort":100,"ownership":{"default":0},"flags":{},"categories":[],"pages":[{"_id":"f75c070f8353c6a3","name":"0. Bienvenue — à lire en premier","sort":100,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/cover.webp\" alt=\"Une vallée la nuit, des lanternes sur la rivière\" /></p>\n<h2>Le scénario en une phrase</h2>\n<p>Dans un village de montagne qui prépare sa fête des lanternes, des gens disparaissent la nuit en suivant une lumière bleue. Cinq jeunes pourfendeurs de démons sont envoyés pour comprendre, sauver les disparus et vaincre le démon... qui fut autrefois un garçon très seul.</p>\n<h2>En pratique</h2>\n<ul>\n<li><strong>Durée :</strong> 3 h à 4 h.</li>\n<li><strong>Joueurs :</strong> 3 à 5, avec les @UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.4510ab2eba54453c]{5 prétirés} fournis (rang Mizunoto, niveau 1).</li>\n<li><strong>Pour qui :</strong> joueurs et MJ débutants. Aucune connaissance du livre n'est nécessaire pour les joueurs.</li>\n<li><strong>Époque :</strong> ère Taishō, un soir d'été.</li>\n<li><strong>Ton :</strong> courage, entraide, frissons, et un peu de compassion pour le démon à la fin — comme dans <em>Demon Slayer</em>.</li>\n</ul>\n<h2>Ce que contient l'aventure</h2>\n<ul>\n<li>Ce <strong>Guide du MJ</strong> : l'histoire secrète, les trois actes pas à pas, les PNJ, la tactique des démons et des aides en cas de difficulté.</li>\n<li>Le journal <strong>Aides de jeu</strong> : documents à montrer aux joueurs (ordre de mission, dessin d'enfant, carnet, plan).</li>\n<li>Le journal <strong>Prétirés</strong> : une page de présentation par personnage, et un aide-mémoire des règles pour les joueurs.</li>\n<li><strong>3 scènes</strong> : @UUID[Scene.297d1308c2b940ce]{le village}, @UUID[Scene.b10091279f704db9]{le pont du festival} et @UUID[Scene.a4bb63a5fcaca659]{l'atelier abandonné}. Les épingles sur les cartes ouvrent la bonne page de ce guide.</li>\n<li><strong>Acteurs</strong> : 5 prétirés, 8 PNJ humains, 2 démons. <strong>Objets</strong> : indices du scénario et la « Livraison Kakushi ».</li>\n</ul>\n<h2>Préparer la partie (10 minutes)</h2>\n<ol>\n<li>Lisez les pages @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.5aa19fc5ec9429ab]{1. L'histoire secrète} et @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.14120edbb3283c9d]{2. Règles express}.</li>\n<li>Donnez à chaque joueur son personnage : clic droit sur l'acteur → <em>Configurer les droits</em> → le joueur devient <em>Propriétaire</em>.</li>\n<li>Montrez aux joueurs la page @UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.4510ab2eba54453c]{Règles express pour les joueurs} (bouton <em>Montrer aux joueurs</em> en haut du journal).</li>\n<li>Activez la scène @UUID[Scene.297d1308c2b940ce]{Hotaru-mura}.</li>\n<li>Gardez la page @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.de5ee5f530ceff56]{8. Tactiques des démons} ouverte pendant les combats.</li>\n</ol>\n<h2>Trois conseils pour un MJ débutant</h2>\n<ul>\n<li><strong>Dites oui aux bonnes idées.</strong> Si un joueur trouve une autre façon de découvrir un indice, donnez-le-lui.</li>\n<li><strong>Les indices ne doivent jamais bloquer.</strong> Chaque information importante peut être trouvée à plusieurs endroits. Un test raté donne l'info plus tard ou avec un prix (du temps perdu, une blessure, une dispute).</li>\n<li><strong>Donnez la parole à chacun.</strong> Chaque prétiré a un sens spécial et un petit objectif personnel : utilisez-les pour mettre chaque joueur en avant au moins une fois.</li>\n</ul>\n<p><em>Illustrations originales générées par IA : couverture, cartes, portraits, indices et pouvoirs. Les cartes conservent les positions des épingles et des jetons du scénario.</em></p>","format":1}},{"_id":"5aa19fc5ec9429ab","name":"1. L'histoire secrète","sort":200,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><em>Ce que les joueurs vont découvrir petit à petit. Ne leur lisez pas cette page.</em></p>\n<h2>Il y a dix ans : Kansuke</h2>\n<p>Kansuke était un orphelin timide, recueilli par @UUID[Actor.673fb972a2abe9c7]{Oume}, la vieille lanternière du village de Hotaru-mura (« le village des lucioles »). Il était très doué : il avait inventé une teinture d'un bleu profond, que tout le monde appelait le <strong>« bleu de Kansuke »</strong>. Mais les autres enfants se moquaient de lui et il se sentait toujours seul.</p>\n<p>Pour la fête des lanternes, il voulait construire une lanterne géante « pour que tout le monde le voie enfin ». Une nuit, seul dans l'ancien atelier sur la colline, il a renversé une lampe. L'atelier a brûlé. On n'a jamais retrouvé son corps. Le village a cru qu'il était mort.</p>\n<p>En réalité, gravement brûlé, Kansuke a rampé dans la forêt. Un homme élégant au regard rouge lui a promis qu'il n'aurait « plus jamais froid, plus jamais seul ». Il lui a donné son sang. Kansuke est devenu un démon.</p>\n<h2>Aujourd'hui : Tomoshibi</h2>\n<p>Après dix ans d'errance, le démon est revenu « à la maison » pour l'anniversaire de l'incendie. Il se fait appeler @UUID[Actor.324fb92506721e68]{Tomoshibi} (« petite flamme »). Il porte un masque de papier huilé pour cacher son visage brûlé. Il vit caché dans le grand four de l'atelier en ruine.</p>\n<p>Dans sa tête de démon, il « protège » les gens : il les enferme dans des <strong>lanternes-cocons</strong> en papier, pour qu'ils restent avec lui, au chaud et dans la lumière. Mais il a faim. Les cocons le nourrissent lentement.</p>\n<h2>Les disparitions</h2>\n<table>\n<tr><th>Quand</th><th>Qui</th><th>Où en est-il ?</th></tr>\n<tr><td>Il y a 12 nuits</td><td>Tatsu, vendeur ambulant de saké</td><td><strong>Mort.</strong> Tomoshibi l'a dévoré. On peut retrouver sa gourde près du pont.</td></tr>\n<tr><td>Il y a 9 nuits</td><td>@UUID[Actor.565e1df29f5ce5ef]{Jirō}, garde forestier</td><td>Vivant, très faible, dans un cocon.</td></tr>\n<tr><td>Il y a 5 nuits</td><td>@UUID[Actor.bc6377feadfeb462]{Fumi}, tisserande</td><td>Vivante, dans un cocon.</td></tr>\n<tr><td>Il y a 2 nuits</td><td>@UUID[Actor.8d7611518c74aed1]{Sota}, 10 ans, fils du charbonnier</td><td>Vivant, dans un cocon. Sa petite sœur @UUID[Actor.96d42fce4749a387]{Mii} l'a vu partir.</td></tr>\n<tr><td>Ce soir (Acte 2)</td><td>@UUID[Actor.96d42fce4749a387]{Mii}</td><td>Tomoshibi l'enlève pendant la fête. Les PJ doivent la sauver.</td></tr>\n</table>\n<h2>Les deux charognards</h2>\n<p>Deux @UUID[Actor.e8901bf35311befc]{Rôdeurs des lanternes} (des démons faibles) ont senti l'odeur des victimes. Tomoshibi les tolère comme des chiens de garde. Ce soir, affamés, ils attaquent la fête. Tomoshibi profite de la panique pour enlever Mii.</p>\n<h2>Le fil rouge des indices</h2>\n<p>Les joueurs doivent comprendre trois choses. Chacune peut être apprise à plusieurs endroits :</p>\n<ol>\n<li><strong>« Les disparus suivent une lumière bleue. »</strong> → @UUID[Actor.35d5c6d00b7bd398]{Okiku} (auberge), @UUID[Actor.96d42fce4749a387]{Mii} (son dessin), la @UUID[Item.024498032613102b]{lanterne bleue}.</li>\n<li><strong>« Le coupable a un lien avec Kansuke. »</strong> → le bleu reconnu par @UUID[Actor.673fb972a2abe9c7]{Oume}, le @UUID[Item.a32f12eb5e164875]{carnet brûlé}, la mémoire du chef @UUID[Actor.32e5d58efe6840c2]{Gonbei Arakawa}.</li>\n<li><strong>« Il se cache dans l'atelier brûlé, sur la colline. »</strong> → le dessin de Mii, les traces sur le chemin, Oume, et au pire les lumières bleues de l'Acte 2.</li>\n</ol>\n<p>Même si les joueurs ne trouvent rien, l'Acte 2 les met sur la piste : ils n'ont qu'à suivre les lumières.</p>","format":1}},{"_id":"14120edbb3283c9d","name":"2. Règles express pour le MJ","sort":300,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p>Les fiches font les calculs : cliquez sur une statistique, une arme ou une technique, et le système lance les dés et affiche le résultat dans le chat. Voici ce qu'il faut savoir pour arbitrer.</p>\n<h2>Les tests</h2>\n<ul>\n<li>On lance <strong>1d20 + un bonus</strong>. Avec une statistique de base (Force, Finesse, Courage, Vitesse, Social, Intellect), le bonus est la valeur <strong>moins 1</strong>. Avec une statistique dérivée (Enquête, Perception, Médecine...), le bonus est sa valeur totale.</li>\n<li>Le livre laisse le MJ fixer la difficulté (DD). Repères utilisés dans ce scénario : <strong>10 = facile, 13 = moyen, 16 = difficile</strong>.</li>\n<li>Les <strong>sens extrasensoriels</strong> (odorat, ouïe, vue, toucher, goût) donnent +3 aux tests de Perception qui utilisent ce sens. Chaque prétiré en a un : profitez-en !</li>\n</ul>\n<h2>Les ressources</h2>\n<ul>\n<li><strong>PV</strong> : la santé. <strong>CA</strong> : la défense (une attaque normale touche si son jet atteint la CA).</li>\n<li><strong>Endurance (E)</strong> : les pourfendeurs la dépensent pour leurs formes de Souffle. À 0, ils doivent récupérer un tour sans attaquer ; s'ils ne font pas de Souffle de récupération pendant 2 rounds, ils s'évanouissent.</li>\n<li><strong>Souffle de récupération</strong> : une action qui rend 1d8 d'Endurance par rang (donc 1d8 pour nos Mizunoto).</li>\n<li><strong>Points de réaction (PR)</strong> : à dépenser à tout moment, même pendant le tour d'un autre. 1 PR = esquive automatique d'une attaque, ou attaque immédiate, ou changer d'arme. Ils ne reviennent qu'avec le repos : c'est la ressource la plus précieuse.</li>\n<li><strong>Points de sang démoniaque (BDP)</strong> : la ressource de @UUID[Actor.3ffc020133c5e086]{Tamaki} (démoniste) et des démons.</li>\n</ul>\n<h2>Le combat</h2>\n<ul>\n<li>Lancez l'initiative avec le suivi de combat de Foundry.</li>\n<li>À son tour, un personnage peut se <strong>déplacer</strong> (9 m) et faire <strong>une action</strong> : attaquer, utiliser une forme de Souffle, utiliser un objet, faire un Souffle de récupération... Il peut aussi <strong>sprinter</strong> au lieu d'agir.</li>\n<li><strong>Les formes de Souffle touchent automatiquement</strong> : pas de jet pour toucher. La seule défense est que la cible dépense un PR pour esquiver. C'est pour ça que les démons perdent vite leurs PR !</li>\n<li><strong>Éviter</strong> : quand on est attaqué, on peut tenter un jet de Finesse au lieu de dépenser un PR. Si on bat le jet d'attaque, on ne prend rien ; si on rate, on ne peut plus dépenser de PR contre cette attaque.</li>\n</ul>\n<h2>Les démons</h2>\n<ul>\n<li>Ils se soignent avec <em>Guérison démoniaque</em> (2 BDP, une action) et font repousser leurs membres avec <em>Repousse</em>.</li>\n<li><strong>Pour tuer un démon</strong>, il faut le <strong>décapiter avec une lame Nichirin</strong> (ou l'exposer au soleil). Sur la fiche : attaquez en visant la <strong>tête</strong> ; si les dégâts atteignent ses PV restants, la tête tombe et le démon part en cendres.</li>\n<li><em>Conseil débutant (choix de MJ, pas une règle du livre) :</em> si un démon tombe à 0 PV sous le coup d'une lame Nichirin, vous pouvez décrire directement la décapitation pour ne pas frustrer la table.</li>\n</ul>\n<h2>La démoniste</h2>\n<ul>\n<li>@UUID[Actor.3ffc020133c5e086]{Tamaki} n'utilise pas de Souffle. Quand un morceau de démon est détaché, elle peut le <strong>manger</strong> (une action) pour gagner des BDP : 1d4+1 pour un démon faible (plus un dé grâce à son <em>Estomac d'acier</em>).</li>\n<li>Avec ses BDP, elle se soigne (<em>Soin démoniaque</em>, ou réaction de soin avec 1 PR).</li>\n</ul>\n<h2>Les états à connaître pour ce scénario</h2>\n<ul>\n<li><strong>Brûlure</strong> : 1 dégât de feu par tour.</li>\n<li><strong>Charmé</strong> : le personnage ne peut pas blesser celui qui l'a charmé et considère ses ennemis comme les siens.</li>\n<li><strong>Emprisonné</strong> : piégé par un art de sang, impossible de bouger tant qu'on n'est pas libéré.</li>\n<li><strong>Triste</strong> : submergé par la culpabilité, la cible doit réussir un test d'Endurance DD 15.</li>\n</ul>\n<p>Les états s'affichent sur les fiches et se cochent/décochent d'un clic.</p>","format":1}},{"_id":"556c70a40de29e23","name":"3. Acte 0 — L'ordre du corbeau (15 min)","sort":400,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><strong>But de la scène :</strong> présenter les personnages, donner la mission, laisser chacun demander un objet.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Fin d'après-midi. La chaleur d'été colle aux uniformes noirs. Vous êtes cinq jeunes pourfendeurs, à peine sortis de la Sélection Finale, réunis dans un salon de thé au pied des montagnes. Vous ne vous connaissez presque pas.</p><p>Soudain, cinq oiseaux se posent en même temps sur la balustrade. Le plus vieux corbeau gonfle ses plumes et crie :</p><p>« KAA ! KAA ! Mission ! Mission ! Village de Hotaru-mura, dans la vallée ! Quatre personnes disparues la nuit ! Démon probable ! Partez avant le coucher du soleil ! KAA ! »</p></blockquote>\n<ol>\n<li>Faites <strong>présenter chaque personnage</strong> en une ou deux phrases : nom, Souffle, une chose visible (le haori de Chiyo, le foulard d'Itsuki...). Ils peuvent lire leur réplique de départ sur leur page de présentation.</li>\n<li>Montrez l'aide de jeu @UUID[JournalEntry.67e0e50226eb8b13.JournalEntryPage.e88f883912c613d6]{Ordre de mission}.</li>\n<li>Présentez @UUID[Actor.8c5fcc3a0a5a7b64]{Shinpei}, le Kakushi qui les accompagne. Il porte un sac énorme et tremble un peu.</li>\n</ol>\n<h2>La livraison Kakushi</h2>\n<p>Le livre prévoit qu'au briefing, les pourfendeurs peuvent <strong>commander des objets</strong> au quartier général. Pour ce scénario : <strong>un objet par personnage</strong>, parmi le dossier <em>Livraison Kakushi</em> (bandage, pansement compressif, trousse de premiers secours, analgésiques, poison de glycine affaiblissant, kunai de glycine). Glissez l'objet choisi sur la fiche du joueur.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Shinpei ouvre son sac en reniflant : « J'ai... j'ai un peu de tout. Mais un seul objet chacun, hein ? Sinon je n'aurai plus rien pour les blessés... et il y aura des blessés. Il y a toujours des blessés. »</p></blockquote>\n<p><strong>Transition :</strong> une heure de marche dans la forêt de cèdres. Le soleil descend quand ils aperçoivent les toits du village et des centaines de lanternes en papier suspendues partout. → @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.776bd451877b54b3]{Acte 1}</p>","format":1}},{"_id":"776bd451877b54b3","name":"4. Acte 1 — Le village des lucioles (60 à 75 min)","sort":500,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><strong>But de l'acte :</strong> enquêter, rencontrer les villageois, comprendre que le danger vient de la colline. Scène : @UUID[Scene.297d1308c2b940ce]{Hotaru-mura}.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Hotaru-mura est un petit village coupé en deux par une rivière claire. Partout, des lanternes de papier attendent la nuit : sur les toits, sur le pont rouge, au-dessus de la rue principale. Ce soir, c'est la fête des lanternes : on dépose des lanternes sur la rivière pour guider les âmes des morts.</p><p>Pourtant, les visages sont fermés. Les mères rentrent leurs enfants. Un homme moustachu à l'éventail vous attend devant le pont, l'air contrarié.</p></blockquote>\n<h2>L'accueil du chef</h2>\n<p>@UUID[Actor.32e5d58efe6840c2]{Gonbei Arakawa} les reçoit poliment mais froidement. Il ne veut pas qu'ils « effraient les visiteurs » et refuse d'annuler la fête : « Le village vit de ses lanternes. Ce sont des ours, ou des fugueurs, rien de plus. » Il leur donne la liste des disparus (voir @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.5aa19fc5ec9429ab]{l'histoire secrète}) et les laisse libres de circuler.</p>\n<p>Un test de <strong>Intuition DD 13</strong> révèle qu'il a peur, et qu'il cache quelque chose à propos d'un vieil incendie. S'ils insistent (<strong>Intimidation ou Tromperie DD 13</strong>, ou simplement avec de bons arguments), il raconte l'histoire de Kansuke (voir @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.69c63ca0cba3d045]{Lieu E}).</p>\n<h2>Les lieux à visiter</h2>\n<p>Laissez les joueurs choisir. Ils peuvent se séparer en petits groupes. Comptez environ 10 minutes par lieu. Quand le soleil se couche (au bout de 3 ou 4 lieux, ou quand l'énergie baisse), passez à l'@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.9b023bc5db5726f9]{Acte 2}.</p>\n<ul>\n<li>@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.c1622f08c79a04fb]{Lieu A — L'auberge du Saule} (Okiku, les rumeurs)</li>\n<li>@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.81bc107cb1d8e16d]{Lieu B — L'atelier d'Oume} (le bleu de Kansuke, le carnet)</li>\n<li>@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.53572b26cb75f0b7]{Lieu C — La hutte du charbonnier} (Mii et son dessin)</li>\n<li>@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.54bb32e6d5d5531a]{Lieu D — Le pont, le sanctuaire et le chemin de la colline} (les traces)</li>\n<li>@UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.69c63ca0cba3d045]{Lieu E — La maison du chef} (le vieil incendie)</li>\n</ul>\n<section class=\"secret\"><p><strong>Si les joueurs bloquent</strong></p><p>Faites intervenir un corbeau Kasugai : « KAA ! Lumière bleue vue sur la colline ! KAA ! », ou faites courir @UUID[Actor.96d42fce4749a387]{Mii} vers eux avec son dessin.</p></section>","format":1}},{"_id":"c1622f08c79a04fb","name":"4A. Lieu A — L'auberge du Saule","sort":600,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Une grande auberge au toit brun, à côté d'un saule pleureur. Une odeur de soupe miso et de brochettes grillées flotte dans l'air. Une femme ronde au tablier fleuri vous fait de grands signes : « Des pourfendeurs ! Entrez, entrez, vous devez avoir faim ! »</p></blockquote>\n<p>@UUID[Actor.35d5c6d00b7bd398]{Okiku} est la meilleure source de rumeurs. Elle offre des @UUID[Item.824d3184242a8025]{dango} (Chiyo va adorer).</p>\n<h2>Ce qu'elle raconte (sans test)</h2>\n<ul>\n<li>L'ordre des disparitions, avec des détails humains : Tatsu « buvait trop mais chantait bien », Jirō « connaît la forêt par cœur, il ne se serait jamais perdu », Fumi « tissait le plus beau bleu du village... enfin, presque ».</li>\n<li>« Les nuits où quelqu'un disparaît, on voit des <strong>lumières bleues</strong> sur la rivière. Des lanternes que personne n'a posées. »</li>\n</ul>\n<h2>Avec un test de Perception ou d'Intuition DD 13</h2>\n<ul>\n<li>Elle baisse la voix : « Ce bleu... la vieille Oume en faisait un pareil, il y a longtemps. Avec son apprenti. Le pauvre garçon est mort dans l'incendie de l'atelier, là-haut. »</li>\n</ul>\n<h2>Moment pour un personnage</h2>\n<p>@UUID[Actor.be1def365020ee8e]{Chiyo} peut gagner la confiance d'Okiku en mangeant tout ce qu'on lui sert. @UUID[Actor.e4340dee3670322a]{Kenta} peut faire rire la salle avec ses histoires de pousse-pousse à Tokyo : les clients se mettent alors à parler (+2 au prochain test social, au choix du MJ).</p>","format":1}},{"_id":"81bc107cb1d8e16d","name":"4B. Lieu B — L'atelier d'Oume","sort":700,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Un atelier sombre et frais, rempli de papier, de bambou et de pots de teinture. Des dizaines de lanternes sèchent dans la cour. Une très vieille femme aux doigts tachés de bleu et de rouge colle du papier sans lever les yeux : « Si vous venez pour les disparus, je n'ai rien vu. Je ne sors plus la nuit. »</p></blockquote>\n<p>@UUID[Actor.673fb972a2abe9c7]{Oume} est méfiante au début, puis touchante. Elle est la clé émotionnelle du scénario.</p>\n<h2>Ce qu'elle dit si on la met en confiance (Social DD 10, ou en l'aidant à son travail)</h2>\n<ul>\n<li>Elle a élevé un orphelin, Kansuke, « un garçon timide qui bégayait, mais avec des mains d'or ».</li>\n<li>Il est mort dans l'incendie de l'ancien atelier, sur la colline, il y a dix ans jour pour jour.</li>\n<li>Elle va encore déposer des fleurs sur une petite stèle près des ruines, le jour, mais elle n'entre jamais.</li>\n</ul>\n<h2>Le bleu de Kansuke</h2>\n<p>Si on lui montre une @UUID[Item.024498032613102b]{lanterne bleue}, ou si on lui décrit précisément les lumières, elle pâlit : « C'est son bleu. Personne d'autre ne sait le faire. Personne. » Elle refuse d'y croire, puis tend le @UUID[Item.a32f12eb5e164875]{carnet brûlé de Kansuke} aux personnages. Montrez l'aide de jeu @UUID[JournalEntry.67e0e50226eb8b13.JournalEntryPage.371267979b4ccb73]{Carnet brûlé de Kansuke}.</p>\n<h2>Indice discret</h2>\n<p>Un test d'<strong>Enquête DD 13</strong> dans l'atelier : trois grands moules à lanterne ont disparu de la réserve il y a deux semaines. Oume pensait les avoir prêtés.</p>\n<h2>Moment pour un personnage</h2>\n<p>@UUID[Actor.038986a70716391b]{Mizuki} (odorat) sent sur les mains d'Oume la même odeur que celle de la teinture des lumières bleues... et autre chose : une odeur de fumée très ancienne. @UUID[Actor.31438a3744a3964b]{Itsuki}, qui a grandi dans un orphelinat, peut comprendre mieux que les autres ce que Kansuke a ressenti.</p>\n<section class=\"secret\"><p><strong>Oume viendra-t-elle ?</strong></p><p>Si les personnages lui demandent de les accompagner, elle refuse d'abord, puis les rejoint à l'Acte 3 (elle suit les lumières avec @UUID[Actor.8c5fcc3a0a5a7b64]{Shinpei}). Sa présence permet la fin la plus émouvante.</p></section>","format":1}},{"_id":"53572b26cb75f0b7","name":"4C. Lieu C — La hutte du charbonnier","sort":800,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<blockquote><p><strong>À lire aux joueurs :</strong></p><p>De l'autre côté du pont, à l'orée de la forêt, une hutte noire de suie fume à côté d'un grand four à charbon. Une petite fille est assise sur le seuil, un sachet rouge serré dans les mains. Elle ne pleure plus. Elle regarde la colline.</p></blockquote>\n<p>@UUID[Actor.96d42fce4749a387]{Mii}, 8 ans. Son père cherche Sota dans la forêt depuis deux jours ; sa mère est malade de chagrin. Personne n'écoute Mii.</p>\n<h2>Gagner sa confiance</h2>\n<p>Pas de test si les personnages sont doux avec elle. Un personnage brusque doit réussir un test de <strong>Social DD 13</strong> (ou de Performance, en faisant le clown).</p>\n<h2>Ce qu'elle raconte</h2>\n<ul>\n<li>« Il y a deux nuits, une lanterne bleue est venue devant la porte. Sota l'a suivie. Il riait, comme quand on rêve. »</li>\n<li>« J'ai vu le monsieur. Il avait une tête de lanterne. Il a pris Sota par la main, gentiment. Ils sont montés là-haut, vers la maison brûlée. »</li>\n<li>Elle montre son dessin : aide de jeu @UUID[JournalEntry.67e0e50226eb8b13.JournalEntryPage.2e715c375aa299a0]{Dessin de Mii}.</li>\n</ul>\n<p>À la fin, elle donne son @UUID[Item.aa2b6412b19471f8]{omamori} au personnage qui lui promet de ramener Sota.</p>\n<h2>Indice physique</h2>\n<p>Un test de <strong>Perception DD 13</strong> (vue ou odorat) près de la porte : de la cendre de papier et une goutte de cire bleue sur la marche. @UUID[Actor.be1def365020ee8e]{Chiyo} (vue) remarque aussi des traces de pieds nus qui partent vers le chemin de la colline. Si les joueurs fouillent les buissons, ils peuvent trouver une petite @UUID[Item.024498032613102b]{lanterne bleue} éteinte.</p>","format":1}},{"_id":"54bb32e6d5d5531a","name":"4D. Lieu D — Le pont, le sanctuaire et le chemin","sort":900,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<h2>Le pont rouge</h2>\n<p>Un test d'<strong>Enquête DD 13</strong> sous le pont : la gourde de saké de Tatsu, coincée entre deux rochers, tachée de sang séché. Le premier disparu est mort.</p>\n<h2>Le sanctuaire aux glycines</h2>\n<p>Un petit sanctuaire au nord-ouest, entouré de glycines en fleurs. Les villageois y prient pour les disparus. C'est ici que Mii a acheté son omamori. C'est un bon endroit pour une scène calme entre personnages.</p>\n<section class=\"secret\"><p><strong>Glycine</strong></p><p>Dans l'univers de <em>Demon Slayer</em>, les démons détestent la glycine. Si un joueur y pense, confirmez que les démons n'aiment pas cet endroit : c'est pour ça qu'aucune disparition n'a eu lieu près du sanctuaire. (Ambiance seulement : le scénario n'ajoute pas de règle.)</p></section>\n<h2>Le chemin de la colline</h2>\n<p>Un sentier part vers le nord-est, à travers les cèdres, jusqu'aux ruines de l'ancien atelier.</p>\n<ul>\n<li><strong>Perception DD 13</strong> : de l'herbe roussie en petits cercles, comme si des lanternes s'étaient posées.</li>\n<li><strong>Survie ou Nature DD 13</strong> : les traces de pas montent, mais aucune ne redescend.</li>\n<li>@UUID[Actor.31438a3744a3964b]{Itsuki} (toucher) sent en posant la main sur un tronc des griffures récentes, profondes : deux créatures différentes sont passées ici (les Rôdeurs).</li>\n<li>@UUID[Actor.e4340dee3670322a]{Kenta} (ouïe) entend, très loin en haut, quelqu'un chanter une berceuse d'une voix d'enfant.</li>\n</ul>\n<section class=\"secret\"><p><strong>Et s'ils montent tout de suite ?</strong></p><p>De jour, ils trouvent les ruines, les trois cocons (vides de démon) et le four fermé : Tomoshibi dort dedans et n'en sortira pas tant que le soleil brille. Ils peuvent libérer les captifs ! Dans ce cas, le soleil se couche pendant qu'ils redescendent avec les blessés : jouez l'Acte 2 sur le chemin, puis Tomoshibi vient lui-même au village chercher « ses » enfants (combat final sur la carte du pont). Adaptez sans stress.</p></section>","format":1}},{"_id":"69c63ca0cba3d045","name":"4E. Lieu E — La maison du chef","sort":1000,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p>La plus grande maison du village. @UUID[Actor.32e5d58efe6840c2]{Gonbei Arakawa} y garde le registre du village.</p>\n<h2>Ce qu'il finit par avouer (voir l'accueil de l'Acte 1)</h2>\n<ul>\n<li>« Il y a dix ans, l'apprenti d'Oume, Kansuke, travaillait seul la nuit dans l'atelier de la colline. Il voulait faire une lanterne géante pour la fête. Ça a brûlé. »</li>\n<li>« On est montés trop tard. On n'a jamais retrouvé le corps... On s'est dit que la forêt l'avait pris. »</li>\n<li>Avec un test d'<strong>Intuition DD 13</strong> : il a honte. Ce soir-là, il avait refusé que Kansuke expose sa lanterne à la fête, parce qu'« elle était bizarre ».</li>\n</ul>\n<h2>Le registre</h2>\n<p>Un test d'<strong>Enquête DD 10</strong> : la date de l'incendie correspond exactement au jour de la première disparition, il y a douze jours... et la fête de ce soir tombe dix ans jour pour jour après l'ouverture de l'atelier par Oume.</p>","format":1}},{"_id":"9b023bc5db5726f9","name":"5. Acte 2 — La nuit des lanternes (45 min)","sort":1100,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><strong>But de l'acte :</strong> un premier combat simple pour apprendre les règles, puis l'enlèvement de Mii qui lance la poursuite. Scène : @UUID[Scene.b10091279f704db9]{Le pont des lanternes}.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>La nuit tombe. Des tambours résonnent. Les villageois, malgré la peur, descendent vers la rivière avec leurs lanternes allumées. Une à une, les petites lumières orange glissent sur l'eau noire. Des lucioles dansent au-dessus. C'est magnifique.</p><p>Puis quelqu'un crie. Parmi les lanternes orange, trois lumières bleues remontent le courant. Contre le courant.</p><p>Et sur la berge, deux silhouettes voûtées sortent des roseaux en ricanant.</p></blockquote>\n<h2>Le combat contre les Rôdeurs</h2>\n<ul>\n<li>Placez les deux jetons de @UUID[Actor.e8901bf35311befc]{Rôdeurs des lanternes} sur la berge sud (ils sont déjà sur la carte, cachés : rendez-les visibles).</li>\n<li>Ce combat sert à <strong>apprendre les règles</strong>. Expliquez à chaque joueur ses options à son premier tour : déplacement, attaque normale, forme de Souffle (touche automatiquement), PR pour esquiver.</li>\n<li>Les Rôdeurs ont 4 PR chacun : ils esquivent les premières formes de Souffle. Expliquez-le aux joueurs : « Il esquive, mais il n'en a plus beaucoup ! »</li>\n<li>Ils attaquent les villageois paniqués s'il n'y a pas de PJ à côté : donnez aux joueurs l'occasion de protéger quelqu'un.</li>\n<li>Tactique simple : voir @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.de5ee5f530ceff56]{Tactiques des démons}.</li>\n</ul>\n<section class=\"secret\"><p><strong>Moment pour la démoniste</strong></p><p>Quand un Rôdeur perd un bras, ou après sa décapitation, @UUID[Actor.3ffc020133c5e086]{Tamaki} peut manger un morceau de sa chair pour gagner des BDP (bouton sur sa fiche). Décrivez la réaction choquée des villageois... et de ses camarades ! Avec son sens du goût, elle sent le papier brûlé et l'huile de lampe dans la chair : ce démon s'est nourri près de l'atelier.</p></section>\n<h2>L'enlèvement de Mii</h2>\n<p>À la fin du 3<sup>e</sup> round (ou quand le premier Rôdeur tombe), jouez cette scène :</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Sur le parapet du pont, une silhouette mince est apparue sans un bruit. Un kimono d'artisan brûlé, un visage caché derrière un masque de papier huilé, deux yeux bleus qui brillent au travers. Dans ses bras, une petite fille endormie, qui serre un sachet rouge.</p><p>Mii.</p><p>La silhouette incline poliment la tête, comme un apprenti devant son maître : « Pardon. Elle avait froid. Je l'emmène voir son frère. » Puis elle s'envole dans un tourbillon de papier et de lumières bleues, vers la colline.</p></blockquote>\n<ul>\n<li>Tomoshibi ne combat pas ici : il fuit. Aucune attaque ne peut l'arrêter (il est déjà hors de portée).</li>\n<li>Les Rôdeurs survivants en profitent pour attaquer, ou fuient si l'un d'eux est mort.</li>\n</ul>\n<h2>Après le combat</h2>\n<ul>\n<li>Les personnages peuvent récupérer une @UUID[Item.024498032613102b]{lanterne bleue} sur la rivière.</li>\n<li>@UUID[Actor.673fb972a2abe9c7]{Oume}, bouleversée, a vu le masque : « Ce masque... c'est le papier qu'il utilisait. Kansuke ? » Elle demande à venir.</li>\n<li><strong>Petit repos (5 minutes de marche)</strong> : chaque personnage peut faire un Souffle de récupération, utiliser un objet de soin et décrire comment il se prépare. Les PR ne reviennent pas (ils ne reviennent qu'avec un vrai repos).</li>\n</ul>\n<p>Transition : les lumières bleues tracent un chemin dans la forêt, comme des miettes de pain. → @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.86591af16a674211]{Acte 3}</p>","format":1}},{"_id":"86591af16a674211","name":"6. Acte 3 — L'atelier abandonné (60 min)","sort":1200,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><strong>But de l'acte :</strong> le combat final, libérer les captifs, et décider comment finit l'histoire de Kansuke. Scène : @UUID[Scene.a4bb63a5fcaca659]{L'atelier abandonné}.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>Au sommet de la colline, au milieu d'une clairière, se dressent les restes noircis d'un grand atelier. Le toit a disparu. Des poutres calcinées pointent vers les étoiles. À l'intérieur brillent trois énormes lanternes de papier, grandes comme des hommes. Dans chacune, une silhouette recroquevillée.</p><p>Une voix douce chante une berceuse. Au milieu des ruines, la créature au masque de papier plie une feuille autour d'une petite fille endormie, avec des gestes d'artisan patient.</p></blockquote>\n<h2>L'approche</h2>\n<ul>\n<li>Un test de <strong>Ruse DD 13</strong> pour approcher en silence (chaque personnage, ou un seul pour le groupe s'il guide les autres). Si la majorité réussit : les personnages agissent tous avant Tomoshibi au premier round (round de surprise).</li>\n<li>Si les personnages foncent ou crient, pas de surprise : Tomoshibi se retourne et dit : « Vous êtes venus pour la fête ? Vous avez froid, vous aussi ? »</li>\n<li>@UUID[Actor.038986a70716391b]{Mizuki} (odorat) sent que la créature et Oume ont « la même odeur de teinture » : c'est bien Kansuke.</li>\n</ul>\n<h2>Ce qu'il y a sur la carte</h2>\n<ul>\n<li><strong>Mii</strong> : au départ dans les bras de Tomoshibi. Au premier tour du démon, il la dépose dans une lanterne inachevée près du four : elle est <strong>Emprisonnée</strong>. Un personnage au contact peut couper le papier (une action, automatique).</li>\n<li><strong>Les trois cocons</strong> (@UUID[Actor.8d7611518c74aed1]{Sota}, @UUID[Actor.bc6377feadfeb462]{Fumi}, @UUID[Actor.565e1df29f5ce5ef]{Jirō}) : un personnage au contact peut couper un cocon (une action, automatique). Le captif tombe, sonné.</li>\n<li><strong>Évacuer</strong> : au round 2, @UUID[Actor.8c5fcc3a0a5a7b64]{Shinpei} arrive (avec Oume si elle les suit). Il emporte un captif libéré par round vers la forêt. Les joueurs peuvent aussi porter quelqu'un (déplacement divisé par deux, pas d'attaque).</li>\n<li><strong>Le four</strong> : la cachette de Tomoshibi. <strong>La trappe</strong> près du four mène à une cave vide (cul-de-sac).</li>\n</ul>\n<h2>Le combat</h2>\n<p>@UUID[Actor.324fb92506721e68]{Tomoshibi} a 50 PV, CA 15, <strong>6 PR</strong> et <strong>2 actions par tour</strong>. Il utilise ses arts de sang depuis sa fiche. Tactique détaillée : @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.de5ee5f530ceff56]{Tactiques des démons}.</p>\n<p>Le combat est plus dur que celui du pont. Rappelez aux joueurs :</p>\n<ul>\n<li>de dépenser leurs PR pour esquiver les arts de sang les plus dangereux ;</li>\n<li>que ses PR sont limités : en enchaînant les formes de Souffle, ils finiront par le toucher ;</li>\n<li>que libérer les captifs compte autant que frapper.</li>\n</ul>\n<h2>Le nom de Kansuke</h2>\n<p>Si @UUID[Actor.673fb972a2abe9c7]{Oume} est là, ou si un personnage a lu le carnet, quelqu'un peut appeler le démon par son vrai nom en lui parlant de sa vie d'avant (une action). Tomoshibi fait alors un test d'<strong>Endurance DD 15</strong> (il a 0 en Endurance : jet de 1d20 seul). S'il rate, il devient <strong>Triste</strong> et perd sa prochaine action (choix du scénario). Une seule fois par combat.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>« Kansuke. » La voix d'Oume tremble. « Tu avais toujours froid aux mains. Je te les réchauffais dans les miennes, tu te souviens ? » Le démon se fige. Derrière le masque, les yeux bleus vacillent comme une flamme sous le vent.</p></blockquote>\n<h2>La fin du combat</h2>\n<ul>\n<li><strong>Victoire</strong> : quand Tomoshibi est décapité, son corps se défait en cendres et en papier brûlé. Jouez la @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.d6adf0e6cb038557]{dernière scène}.</li>\n<li><strong>S'il est en mauvaise posture</strong> (moins de 15 PV et plus de BDP pour se soigner) : il tente de se réfugier dans le four. Bloquer l'entrée du four est une bonne idée de joueur !</li>\n<li><strong>Si les personnages sont en mauvaise posture</strong> : voir @UUID[JournalEntry.bc3c8fdd1a3d5b97.JournalEntryPage.4edae099ea4bae5a]{Si ça tourne mal}.</li>\n</ul>","format":1}},{"_id":"d6adf0e6cb038557","name":"7. Épilogue","sort":1300,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<h2>La dernière lumière de Kansuke</h2>\n<p>Comme souvent dans <em>Demon Slayer</em>, le démon retrouve un peu de son humanité au moment de disparaître.</p>\n<blockquote><p><strong>À lire aux joueurs :</strong></p><p>La tête roule sur le plancher brûlé. Le masque de papier se détache. Dessous, il n'y a qu'un visage de garçon, couvert de vieilles cicatrices, qui regarde le ciel.</p><p>« Grand-mère... j'ai froid aux mains. »</p><p>Le corps s'effrite en cendres et en flocons de papier bleu, qui montent vers les étoiles comme des lanternes.</p></blockquote>\n<ul>\n<li>Si Oume est là, elle prend la main qui s'efface. Si elle n'est pas là, un personnage peut le faire. Laissez ce moment respirer.</li>\n<li>Certains personnages auront pitié, d'autres non (@UUID[Actor.31438a3744a3964b]{Itsuki} déteste les démons). Les deux réactions sont justes : c'est un beau moment de roleplay.</li>\n</ul>\n<h2>Le retour au village</h2>\n<ul>\n<li>Au lever du jour, les captifs sont soignés à l'auberge. @UUID[Actor.8d7611518c74aed1]{Sota} retrouve Mii. Si un personnage rend l'omamori à Sota, Mii lui saute au cou.</li>\n<li>@UUID[Actor.32e5d58efe6840c2]{Gonbei Arakawa} présente des excuses maladroites. Il propose qu'à la prochaine fête, une lanterne bleue soit posée sur la rivière pour Kansuke.</li>\n<li>Oume offre à chaque personnage une petite lanterne de papier.</li>\n<li>Les corbeaux arrivent : « KAA ! Mission accomplie ! Repos ! Puis nouvelle mission ! KAA ! »</li>\n</ul>\n<h2>Bilan de mission</h2>\n<table>\n<tr><th>Résultat</th><th>Conséquence</th></tr>\n<tr><td>Les 4 captifs sauvés (Mii, Sota, Fumi, Jirō)</td><td>Victoire totale : le village gardera toujours une chambre pour les pourfendeurs.</td></tr>\n<tr><td>1 ou 2 captifs perdus</td><td>Victoire amère : jouez le deuil avec sobriété.</td></tr>\n<tr><td>Tomoshibi en fuite</td><td>Il reviendra. Une suite toute trouvée !</td></tr>\n</table>\n<h2>Et si vous continuez la campagne ?</h2>\n<p>Après une mission réussie, un personnage qui a la compétence <em>Pratiquer un souffle secondaire</em> peut apprendre une forme (bouton de progression de mission sur la fiche). Pour la montée en rang, suivez le chapitre « Progression » du livre.</p>\n<h2>Les objectifs personnels</h2>\n<p>Demandez à chaque joueur si son personnage a atteint son petit objectif (voir les pages de présentation des prétirés). Applaudissez ceux qui l'ont joué !</p>","format":1}},{"_id":"6c2600915fc738ef","name":"8. PNJ — fiches rapides","sort":1400,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p>Une phrase pour les jouer, une phrase pour ce qu'ils savent.</p>\n<table>\n<tr><th>PNJ</th><th>Comment le jouer</th><th>Ce qu'il sait / fait</th></tr>\n<tr><td>@UUID[Actor.8c5fcc3a0a5a7b64]{Shinpei}</td><td>Voix tremblante, se cache derrière son sac, s'excuse tout le temps.</td><td>La liste des disparus. Livre un objet par personnage. Évacue les captifs à l'Acte 3.</td></tr>\n<tr><td>@UUID[Actor.32e5d58efe6840c2]{Gonbei Arakawa}</td><td>S'évente nerveusement, parle d'argent, finit par avoir honte.</td><td>L'incendie, la lanterne « bizarre » refusée. Le registre.</td></tr>\n<tr><td>@UUID[Actor.35d5c6d00b7bd398]{Okiku}</td><td>Rit fort, tutoie tout le monde, nourrit tout le monde.</td><td>Les lumières bleues, les détails sur les disparus, le lien avec Oume.</td></tr>\n<tr><td>@UUID[Actor.673fb972a2abe9c7]{Oume}</td><td>Parle peu, lentement, les mains toujours occupées.</td><td>Kansuke, le bleu, le carnet, la stèle. Peut appeler le démon par son nom.</td></tr>\n<tr><td>@UUID[Actor.96d42fce4749a387]{Mii}</td><td>Petite voix, regarde ses pieds, puis vous fixe droit dans les yeux.</td><td>A vu Sota partir avec « le monsieur à tête de lanterne ». Son dessin.</td></tr>\n<tr><td>Captifs : @UUID[Actor.8d7611518c74aed1]{Sota}, @UUID[Actor.bc6377feadfeb462]{Fumi}, @UUID[Actor.565e1df29f5ce5ef]{Jirō}</td><td>Faibles, perdus, comme réveillés d'un rêve.</td><td>« Il nous parlait. Il disait qu'on était sa famille. »</td></tr>\n</table>","format":1}},{"_id":"de5ee5f530ceff56","name":"9. Tactiques des démons","sort":1500,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<h2>@UUID[Actor.e8901bf35311befc]{Rôdeurs des lanternes} (Acte 2) — démons faibles</h2>\n<p><strong>35 PV, CA 11, 4 PR, 1 action par tour.</strong> Morsure 1d4+2, Griffure 3. Deux jetons, un seul acteur.</p>\n<ol>\n<li>Ils attaquent la cible la plus proche (un PJ ou un villageois).</li>\n<li>Ils dépensent un PR pour esquiver chaque forme de Souffle tant qu'ils en ont.</li>\n<li>Sous 15 PV, chacun utilise une fois <em>Guérison démoniaque</em> (conseil MJ : une seule fois, pour garder le combat court).</li>\n<li>Si l'un des deux est décapité, l'autre tente de fuir vers la forêt.</li>\n</ol>\n<h2>@UUID[Actor.324fb92506721e68]{Tomoshibi} (Acte 3) — démon de rang élevé</h2>\n<p><strong>50 PV, CA 15, 6 PR, 50 BDP, 2 actions par tour.</strong> Morsure 1d4+3, Griffure 4, et ses arts de sang (sur sa fiche) :</p>\n<ul>\n<li><strong>Feu follet bleu</strong> (3 BDP) : attaque à 9 m, 1d6 + Finesse, Brûlure.</li>\n<li><strong>Lueur d'oubli</strong> (5 BDP) : attaque à 9 m, 1d4, Charmé.</li>\n<li><strong>Lanterne-prison</strong> (6 BDP) : attaque à 4,5 m, 1d4, Emprisonné.</li>\n<li><strong>Guérison démoniaque</strong> (2 BDP) : il se soigne de 2d10 PV.</li>\n</ul>\n<h3>Son plan, round par round</h3>\n<table>\n<tr><th>Round</th><th>Action 1</th><th>Action 2</th></tr>\n<tr><td>1</td><td>Dépose Mii dans une lanterne (elle est Emprisonnée).</td><td>Lueur d'oubli sur le personnage qui semble le plus fort.</td></tr>\n<tr><td>2</td><td>Feu follet bleu sur un personnage à distance.</td><td>Lanterne-prison sur quiconque s'approche d'un cocon.</td></tr>\n<tr><td>3 et après</td><td>Griffure ou Feu follet sur le personnage le plus blessé.</td><td>Sous 25 PV : Guérison démoniaque. Sinon, Lanterne-prison.</td></tr>\n</table>\n<h3>Ses réactions</h3>\n<ul>\n<li>Il esquive (1 PR) les formes de Souffle qui font le plus mal (Coup de tonnerre et éclair, Univers flamboyant, Tigre de flamme...).</li>\n<li>Il ne dépense pas de PR contre les attaques normales : il compte sur sa CA.</li>\n<li>Quand il n'a plus de PR, décrivez qu'il commence à paniquer.</li>\n</ul>\n<h3>Ce qu'il dit</h3>\n<ul>\n<li>« Ne criez pas. Ici, personne n'a froid. Personne n'est seul. »</li>\n<li>« Vous voulez une lanterne, vous aussi ? Je peux en faire une très belle. »</li>\n<li>(Blessé) « Pourquoi ? Pourquoi personne ne veut rester avec moi ? »</li>\n</ul>\n<section class=\"secret\"><p><strong>Régler la difficulté</strong></p><p><strong>Table de 3 joueurs, ou joueurs en difficulté :</strong> retirez-lui 2 PR (4 au lieu de 6) et 10 PV au départ. <strong>Table expérimentée :</strong> laissez-le utiliser Guérison démoniaque deux fois. Ces réglages sont des choix de MJ, pas des règles du livre.</p></section>","format":1}},{"_id":"4edae099ea4bae5a","name":"10. Si ça tourne mal","sort":1600,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<h2>Un personnage tombe à 0 PV</h2>\n<p>Suivez les règles de blessures graves et de mort du livre (chapitres « Blessures » et « Mort »). Pour un one-shot débutant, nous conseillons de ne pas tuer de personnage avant l'Acte 3 : un PJ à 0 PV à l'Acte 2 est simplement assommé et se réveille après le combat avec 1 PV.</p>\n<h2>Le groupe va perdre le combat final</h2>\n<ul>\n<li><strong>La demande d'assistance</strong> (règle du livre) : un personnage peut utiliser le code d'urgence pour appeler des pourfendeurs plus expérimentés. Au bout de 3 rounds, un pourfendeur de haut rang arrive : utilisez par exemple <em>Renjiro, Hashira de la Flamme</em> du compendium « Acteurs - Slayers ». Il met fin au combat en un coup... mais les personnages sauront qu'ils ont eu besoin d'aide.</li>\n<li><strong>Oume</strong> arrive et appelle Kansuke (si ce n'est pas déjà fait).</li>\n<li><strong>L'aube</strong> : si le combat traîne vraiment, décrivez le ciel qui pâlit. Tomoshibi doit fuir vers le four : les personnages peuvent l'en empêcher pour que le soleil le brûle.</li>\n</ul>\n<h2>Les joueurs ne trouvent pas la piste</h2>\n<p>L'Acte 2 les met de toute façon sur le chemin : Mii est enlevée et les lumières bleues montrent la route.</p>\n<h2>Les joueurs veulent attaquer Tomoshibi au pont</h2>\n<p>Il est déjà hors de portée et disparaît dans la forêt. Ne lancez pas de dés : c'est une scène de transition.</p>\n<h2>Un joueur arrive en retard ou part tôt</h2>\n<p>Son personnage peut être avec Shinpei (il arrive avec lui à l'Acte 3) ou rester au village pour protéger les villageois.</p>","format":1}},{"_id":"7ed76075246f5082","name":"11. Aide-mémoire des tests","sort":1700,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<table>\n<tr><th>Moment</th><th>Test</th><th>DD</th><th>Réussite</th></tr>\n<tr><td>Accueil du chef</td><td>Intuition</td><td>13</td><td>Il a peur et cache un vieil incendie.</td></tr>\n<tr><td>Faire parler le chef</td><td>Intimidation ou Tromperie</td><td>13</td><td>L'histoire de Kansuke.</td></tr>\n<tr><td>Auberge</td><td>Perception ou Intuition</td><td>13</td><td>Le bleu rappelle celui d'Oume.</td></tr>\n<tr><td>Atelier d'Oume</td><td>Social (ou l'aider)</td><td>10</td><td>Elle parle de Kansuke.</td></tr>\n<tr><td>Atelier d'Oume</td><td>Enquête</td><td>13</td><td>Trois grands moules ont disparu.</td></tr>\n<tr><td>Hutte du charbonnier</td><td>Social ou Performance (si brusque)</td><td>13</td><td>Mii parle et montre son dessin.</td></tr>\n<tr><td>Hutte du charbonnier</td><td>Perception</td><td>13</td><td>Cire bleue, cendre de papier, traces vers la colline.</td></tr>\n<tr><td>Sous le pont</td><td>Enquête</td><td>13</td><td>La gourde de Tatsu : il est mort.</td></tr>\n<tr><td>Chemin de la colline</td><td>Perception</td><td>13</td><td>Herbe roussie en cercles.</td></tr>\n<tr><td>Chemin de la colline</td><td>Survie ou Nature</td><td>13</td><td>Les traces montent, aucune ne redescend.</td></tr>\n<tr><td>Registre du chef</td><td>Enquête</td><td>10</td><td>Les dates coïncident avec l'incendie.</td></tr>\n<tr><td>Approche de l'atelier</td><td>Ruse</td><td>13</td><td>Round de surprise.</td></tr>\n<tr><td>Se libérer d'une Lanterne-prison</td><td>Force</td><td>13</td><td>Libre (ou un allié coupe le papier).</td></tr>\n<tr><td>Appeler « Kansuke »</td><td>Endurance (pour le démon)</td><td>15</td><td>S'il rate : Triste, perd sa prochaine action.</td></tr>\n</table>\n<p><em>Les DD 10/13/16 sont des repères de ce scénario ; le livre laisse le MJ fixer la difficulté. Le DD 15 de l'état Triste vient du livre.</em></p>","format":1}}],"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"67e0e50226eb8b13","name":"Les Lanternes de Hotaru — Aides de jeu","folder":"401475af84dabdb1","sort":200,"ownership":{"default":0},"flags":{},"categories":[],"pages":[{"_id":"e88f883912c613d6","name":"Ordre de mission","sort":100,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p style=\"text-align:center\"><strong>CORPS DES POURFENDEURS DE DÉMONS</strong><br /><em>Ordre transmis par corbeau Kasugai</em></p>\n<hr />\n<p><strong>Destinataires :</strong> les pourfendeurs de rang Mizunoto présents au salon de thé du col de Kirizawa.</p>\n<p><strong>Lieu :</strong> Hotaru-mura, village de lanterniers, une heure de marche vers la vallée.</p>\n<p><strong>Situation :</strong> quatre villageois ont disparu la nuit en douze jours. Aucune trace de lutte. Un démon est probable.</p>\n<p><strong>Disparus :</strong></p>\n<ul>\n<li>Tatsu, vendeur ambulant de saké — il y a 12 nuits</li>\n<li>Jirō, garde forestier — il y a 9 nuits</li>\n<li>Fumi, tisserande, 17 ans — il y a 5 nuits</li>\n<li>Sota, 10 ans, fils du charbonnier — il y a 2 nuits</li>\n</ul>\n<p><strong>Mission :</strong> enquêter, retrouver les disparus, éliminer la menace.</p>\n<p><strong>Soutien :</strong> le Kakushi Shinpei vous accompagne avec du matériel.</p>\n<p><strong>Attention :</strong> ce soir a lieu la fête des lanternes. Beaucoup de monde dehors après le coucher du soleil.</p>\n<hr />\n<p style=\"text-align:center\"><em>« KAA ! Partez avant le coucher du soleil ! KAA ! »</em></p>","format":1}},{"_id":"2e715c375aa299a0","name":"Dessin de Mii","sort":200,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"image","src":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/handouts/dessin-de-mii.webp","image":{"caption":"Un dessin au crayon de couleur : un monsieur à tête de lanterne, des lumières bleues, un petit garçon qu'on emmène par la main vers la maison sur la colline."}},{"_id":"371267979b4ccb73","name":"Carnet brûlé de Kansuke","sort":300,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/items/carnet-kansuke.webp\" width=\"320\" alt=\"Un carnet de lanternier aux bords brûlés\" /></p>\n<p><em>Un petit carnet aux pages jaunies, les bords noircis par le feu. L'écriture est soignée, un peu tremblante. Entre les phrases, des dessins de lanternes très précis.</em></p>\n<hr />\n<p><em>Printemps.</em> Grand-mère dit que mon bleu est le plus beau de la vallée. Les autres disent que c'est la couleur des noyés. Je m'en fiche. Enfin, presque.</p>\n<p><em>Été.</em> J'ai trouvé comment faire tenir le bleu sur le papier huilé : il faut de l'indigo, de la cendre de cèdre et beaucoup de patience. Personne d'autre ne sait. C'est mon secret.</p>\n<p><em>Été.</em> Les garçons du village m'ont encore jeté dans la rivière. Grand-mère m'a réchauffé les mains dans les siennes. Elle dit que j'ai toujours les mains froides.</p>\n<p><em>Fin de l'été.</em> Je vais faire une lanterne géante pour la fête. Si grande que tout le monde la verra. Si grande qu'on pourra tenir dedans. Comme ça, personne ne sera plus jamais seul, ni dans le noir, ni dans le froid.</p>\n<p><em>(Plus bas, d'une autre encre :)</em> Le chef dit que ma lanterne est bizarre et qu'elle ne sera pas sur la rivière. Tant pis. Je travaillerai la nuit, là-haut, dans le vieil atelier. Je la finirai quand même.</p>\n<hr />\n<p><em>Les dernières pages sont brûlées. Sur la dernière ligne lisible, on devine : « ... Kansuke, apprenti lanternier ».</em></p>","format":1}},{"_id":"dd3424be25b83bdd","name":"Plan du village","sort":400,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"image","src":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/maps/hotaru-mura.webp","image":{"caption":"Hotaru-mura : le sanctuaire aux glycines (nord-ouest), la maison du chef, l'auberge du Saule près du pont rouge, l'atelier d'Oume (sud), la hutte du charbonnier (est) et le chemin qui monte vers la colline (nord-est)."}}],"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"d3e0cd2a73dfc8a1","name":"Les Lanternes de Hotaru — Prétirés","folder":"401475af84dabdb1","sort":300,"ownership":{"default":2},"flags":{},"categories":[],"pages":[{"_id":"49c5935a2366eece","name":"Les cinq pourfendeurs","sort":100,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p>Voici les cinq jeunes pourfendeurs de cette aventure. Ils sont tous de rang <strong>Mizunoto</strong> (le premier rang) et viennent de réussir la Sélection Finale. Ils ne se connaissent presque pas.</p>\n<ul>\n<li>@UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.a08c14b146fe1e3c]{Mizuki Asagiri} — Souffle de l'Eau, la grande sœur protectrice. <em>Conseillée pour un premier joueur.</em></li>\n<li>@UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.e54a3340342cadd2]{Kenta Hayase} — Souffle de la Foudre, rapide et peureux.</li>\n<li>@UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.6a53afe8e747f3e8]{Chiyo Akabane} — Souffle de la Flamme, fille de forgeron, force brute.</li>\n<li>@UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.adfa11e9b27b0961]{Itsuki Kazahaya} — Souffle du Vent, bourru au grand cœur.</li>\n<li>@UUID[JournalEntry.d3e0cd2a73dfc8a1.JournalEntryPage.6a84b0ecbc90addc]{Tamaki Kurosu} — Démoniste, soigneuse et tireuse qui mange les démons.</li>\n</ul>\n<p>À 3 ou 4 joueurs, gardez de préférence Mizuki et Tamaki (soins) et choisissez les autres librement.</p>","format":1}},{"_id":"4510ab2eba54453c","name":"Règles express pour les joueurs","sort":200,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p>Tout se fait depuis votre fiche : cliquez, le système lance les dés et explique le résultat dans le chat.</p>\n<h2>Faire un test</h2>\n<p>Le MJ demande un test (par exemple « Perception »). Cliquez sur la statistique dans votre fiche : on lance <strong>1d20 + votre bonus</strong>. Si le total atteint la difficulté, c'est réussi. Pensez à votre <strong>sens spécial</strong> (odorat, ouïe, vue, toucher ou goût) : il donne +3 aux tests de Perception qui l'utilisent. Dites-le au MJ !</p>\n<h2>Vos ressources</h2>\n<table>\n<tr><th>Ressource</th><th>À quoi ça sert</th></tr>\n<tr><td><strong>PV</strong></td><td>Votre santé. À 0, vous êtes hors combat.</td></tr>\n<tr><td><strong>CA</strong></td><td>Votre défense. Une attaque normale vous touche si son jet atteint votre CA.</td></tr>\n<tr><td><strong>Endurance (E)</strong></td><td>Le « carburant » de vos formes de Souffle. À 0, vous devez reprendre votre souffle un tour.</td></tr>\n<tr><td><strong>Points de réaction (PR)</strong></td><td>Vos réflexes. Dépensez-en à tout moment, même pendant le tour d'un autre. Ils ne reviennent qu'avec le repos : gardez-les pour les grosses attaques !</td></tr>\n<tr><td><strong>BDP</strong> (Tamaki seulement)</td><td>Le sang démoniaque, gagné en mangeant de la chair de démon. Sert à se soigner.</td></tr>\n</table>\n<h2>Votre tour en combat</h2>\n<ol>\n<li><strong>Bougez</strong> (jusqu'à 9 m), avant ou après votre action.</li>\n<li><strong>Faites une action</strong> :\n<ul>\n<li><strong>Forme de Souffle</strong> : coûte de l'Endurance et <strong>touche automatiquement</strong>. Seule défense : l'ennemi dépense un PR pour esquiver. C'est votre meilleure arme.</li>\n<li><strong>Attaque normale</strong> : gratuite, mais il faut toucher la CA de l'ennemi.</li>\n<li><strong>Souffle de récupération</strong> : vous regagnez 1d8 d'Endurance.</li>\n<li><strong>Utiliser un objet</strong> : bandage, trousse de soins...</li>\n<li><strong>Libérer quelqu'un</strong> : couper un cocon ou une lanterne-prison au contact.</li>\n</ul></li>\n<li>Vous pouvez aussi <strong>sprinter</strong> au lieu de faire une action, pour aller plus loin.</li>\n</ol>\n<h2>Quand on vous attaque</h2>\n<ul>\n<li><strong>Esquiver (1 PR)</strong> : l'attaque vous rate, automatiquement.</li>\n<li><strong>Éviter (gratuit)</strong> : jet de Finesse contre le jet d'attaque. Si vous ratez, vous ne pouvez plus dépenser de PR contre cette attaque. Risqué !</li>\n</ul>\n<h2>Tuer un démon</h2>\n<p>Un démon se régénère. Pour le tuer, il faut lui <strong>trancher la tête avec une lame Nichirin</strong> (ou l'exposer au soleil). Quand il est bien affaibli, attaquez en visant la <strong>tête</strong>.</p>\n<h2>Jouer ensemble</h2>\n<ul>\n<li>Décrivez ce que fait votre personnage, pas seulement le bouton que vous cliquez.</li>\n<li>Protégez les villageois : les pourfendeurs sont là pour eux.</li>\n<li>Chaque personnage a un <strong>petit objectif secret</strong> sur sa page : essayez de le jouer !</li>\n</ul>","format":1}},{"_id":"a08c14b146fe1e3c","name":"Mizuki Asagiri","sort":300,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/mizuki-asagiri.webp\" width=\"160\" height=\"160\" alt=\"Portrait de Mizuki Asagiri\" style=\"float:right;margin-left:1em\" /></p>\n<h2>Mizuki Asagiri, 16 ans</h2>\n<p><em>Souffle de l'Eau — la grande sœur du groupe</em> — fiche : @UUID[Actor.038986a70716391b]{Mizuki Asagiri}</p>\n<h2>Qui tu es</h2><p>Tu as grandi dans un village de pêcheurs. Il y a trois ans, un démon a emporté ton petit frère pendant que tu dormais. Tu as juré que plus aucun enfant ne disparaîtrait devant toi. Maître Sagara, un ancien Hashira de l'Eau, t'a appris à te battre avec douceur et précision.</p>\n<h2>Ta personnalité</h2><ul><li>Calme, attentionnée, tu remarques quand quelqu'un a peur.</li><li>Tu prends soin des autres avant toi-même.</li><li>Tu crois que même les démons ont été humains un jour.</li></ul>\n<h2>Ton rôle dans le groupe</h2><p>Tu es polyvalente : de bonnes attaques, une attaque de zone, une attaque à distance, et beaucoup de Finesse pour éviter les coups.</p>\n<p><strong>PV</strong> 20 · <strong>CA</strong> 13 · <strong>Endurance</strong> 24 · <strong>PR</strong> 10</p>\n<h2>Trois conseils</h2><ul><li>Ton <strong>odorat</strong> (+3 en Perception) te permet de sentir les démons et les indices. Pense à renifler !</li><li><strong>Marée battante</strong> frappe tous les ennemis proches : idéale contre les deux Rôdeurs.</li><li>Ta posture de l'<strong>Eau Écrasante</strong> améliore tes attaques normales (+2 pour toucher, +4 dégâts) mais te ralentit.</li></ul>\n<h2>Tes formes de Souffle</h2><p>Elles <strong>touchent automatiquement</strong> (sauf si l'ennemi dépense un PR pour esquiver) et coûtent de l'Endurance (E).</p><table><tr><th>Forme</th><th>Nom</th><th>E</th><th>Dégâts</th><th>Portée</th><th>En clair</th></tr><tr><td>1</td><td><strong>Surface de l'eau coupée</strong></td><td>3</td><td>3d6 + Finesse</td><td>3m</td><td>Une frappe concentrée en ligne droite. Simple et efficace.</td></tr><tr><td>2</td><td><strong>Roue à eau</strong></td><td>5</td><td>2d8 + Force</td><td>4.5m</td><td>Un saut et une rotation verticale : une attaque qui utilise votre Force.</td></tr><tr><td>4</td><td><strong>Marée battante</strong></td><td>12</td><td>3d6 + Finesse</td><td>7.5m</td><td>Une série d'entailles qui frappe <strong>tous les ennemis à portée</strong>. Chère, gardez-la pour un groupe.</td></tr><tr><td>5</td><td><strong>Pluie miséricordieuse par temps sec</strong></td><td>1</td><td>3d8 + Finesse</td><td>1.5m / CàC</td><td>Le « coup bienveillant » qui tue sans douleur. Il faut <strong>charger un tour</strong> avant (une attaque reçue interrompt la charge). Parfait pour achever un démon qui ne se défend plus.</td></tr><tr><td>8</td><td><strong>Bassin de la cascade</strong></td><td>5</td><td>1d20 + Force</td><td>1.5m / CàC</td><td>Une puissante coupe verticale.</td></tr><tr><td>9</td><td><strong>Éclaboussure d'eau</strong></td><td>6</td><td>1d10 + Finesse</td><td>9m\n*Ignore la diffuculté du terrain</td><td>Une attaque à <strong>9 m</strong> : pour toucher un ennemi loin de vous.</td></tr></table>\n<h2>Ton corbeau</h2><p>Shizuku est un vieux corbeau calme qui adore Mizuki et lui rapporte des cailloux brillants.</p>\n<h2>Tes liens</h2><p>Kenta te fait rire et tu le protèges comme un petit frère. Itsuki est trop dur avec les démons à ton goût.</p>\n<h2>Ton petit objectif secret</h2><p>Ramener Sota vivant à sa petite sœur. Et, si possible, offrir une mort paisible au démon.</p>\n<h2>Pour commencer</h2><blockquote><p>« Restez derrière moi. Personne ne disparaîtra ce soir. »</p></blockquote>","format":1}},{"_id":"e54a3340342cadd2","name":"Kenta Hayase","sort":400,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/kenta-hayase.webp\" width=\"160\" height=\"160\" alt=\"Portrait de Kenta Hayase\" style=\"float:right;margin-left:1em\" /></p>\n<h2>Kenta Hayase, 15 ans</h2>\n<p><em>Souffle de la Foudre — rapide comme l'éclair, peureux comme un lapin</em> — fiche : @UUID[Actor.e4340dee3670322a]{Kenta Hayase}</p>\n<h2>Qui tu es</h2><p>Avant, tu tirais un pousse-pousse dans les rues de Tokyo. Tu étais le plus rapide du quartier. Un soir, un démon a attaqué ton client ; tu t'es enfui... et tu ne te l'es jamais pardonné. Depuis, tu cours vers le danger. Même si tes jambes tremblent.</p>\n<h2>Ta personnalité</h2><ul><li>Bavard, vantard, drôle.</li><li>Tu as très peur, et tu le dis (fort).</li><li>Quand un ami est en danger, la peur disparaît d'un coup.</li></ul>\n<h2>Ton rôle dans le groupe</h2><p>Tu es le plus rapide du groupe (CA 15, 10 PR). Tu connais <strong>les six formes</strong> de la Foudre, ce qui te donne une capacité spéciale : <strong>Vitesse de la lumière</strong> (un déplacement éclair de 6 m en réaction).</p>\n<p><strong>PV</strong> 20 · <strong>CA</strong> 15 · <strong>Endurance</strong> 23 · <strong>PR</strong> 10</p>\n<h2>Trois conseils</h2><ul><li>Ton <strong>ouïe</strong> (+3 en Perception) te fait entendre ce que les autres ne perçoivent pas.</li><li><strong>Boule de foudre</strong> ne coûte qu'1 Endurance : c'est ton attaque de tous les jours.</li><li><strong>Coup de tonnerre et éclair</strong> ne peut pas être esquivé : garde-le pour le démon final.</li></ul>\n<h2>Tes formes de Souffle</h2><p>Elles <strong>touchent automatiquement</strong> (sauf si l'ennemi dépense un PR pour esquiver) et coûtent de l'Endurance (E).</p><table><tr><th>Forme</th><th>Nom</th><th>E</th><th>Dégâts</th><th>Portée</th><th>En clair</th></tr><tr><td>1</td><td><strong>Coup de tonnerre et éclair</strong></td><td>11</td><td>3d20 + Force ou Finesse</td><td>Pas de limite</td><td>Votre arme secrète : un éclair en ligne droite, <strong>impossible à esquiver</strong>. Il faut <strong>charger un tour</strong> avant. Très coûteux.</td></tr><tr><td>2</td><td><strong>Boule de foudre</strong></td><td>1</td><td>3d6 + Finesse</td><td>4.5m</td><td>Cinq coups en un éclair, pour 1 seule Endurance ! Ensuite, il faut attendre un tour avant de la refaire.</td></tr><tr><td>3</td><td><strong>Tonnerre de moustiques bourdonnants</strong></td><td>9</td><td>1d20 + Finesse</td><td>6m</td><td>Une onde de foudre qui frappe <strong>tous les ennemis à portée</strong>. Attention aux alliés.</td></tr><tr><td>4</td><td><strong>Tonnerre lointain</strong></td><td>12</td><td>3d8 Force</td><td>Pas de limite</td><td>Des frappes à distance sur une seule cible, même très loin.</td></tr><tr><td>5</td><td><strong>Foudre de chaleur</strong></td><td>6</td><td>3d8 + Force</td><td>1.5m / CàC</td><td>Une coupe unique, concentrée et tranchante.</td></tr><tr><td>6</td><td><strong>Pluie d'éclairs électriques</strong></td><td>10</td><td>2d20 + Finesse</td><td>4.5m</td><td>Une pluie d'éclairs très puissante. Il faut <strong>charger un tour</strong> avant.</td></tr></table>\n<h2>Ton corbeau</h2><p>Rairai est un geai bleu qui l'apprécie... mais le picore quand il se vante.</p>\n<h2>Tes liens</h2><p>Chiyo t'impressionne (et te fait un peu peur). Mizuki est gentille avec toi : tu veux qu'elle soit fière.</p>\n<h2>Ton petit objectif secret</h2><p>Prouver (à toi-même) que tu n'es pas un lâche : faire un acte vraiment courageux devant les autres.</p>\n<h2>Pour commencer</h2><blockquote><p>« Un démon ? Ici ? Ha ha... Bien sûr que je n'ai pas peur. Quelqu'un d'autre passe devant ? »</p></blockquote>","format":1}},{"_id":"6a53afe8e747f3e8","name":"Chiyo Akabane","sort":500,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/chiyo-akabane.webp\" width=\"160\" height=\"160\" alt=\"Portrait de Chiyo Akabane\" style=\"float:right;margin-left:1em\" /></p>\n<h2>Chiyo Akabane, 17 ans</h2>\n<p><em>Souffle de la Flamme — la force qui fonce</em> — fiche : @UUID[Actor.be1def365020ee8e]{Chiyo Akabane}</p>\n<h2>Qui tu es</h2><p>Tu es la fille d'un forgeron de lames Nichirin. Tu as grandi au milieu des étincelles, des marteaux et des pourfendeurs qui passaient à la forge. Tu as toujours voulu être l'une d'eux. Ton père a forgé une partie de ta lame.</p>\n<h2>Ta personnalité</h2><ul><li>Énergique, franche, rire énorme.</li><li>Gourmande : tu manges trois bols de riz à chaque repas.</li><li>Protectrice : personne ne touche aux enfants devant toi.</li></ul>\n<h2>Ton rôle dans le groupe</h2><p>Tu frappes très fort (Force 5, plus ta <strong>Force physique accrue</strong>). Ta posture du <strong>Feu Protecteur</strong> te donne +4 CA après une attaque normale.</p>\n<p><strong>PV</strong> 20 · <strong>CA</strong> 12 · <strong>Endurance</strong> 24 · <strong>PR</strong> 7</p>\n<h2>Trois conseils</h2><ul><li>Ta <strong>vue</strong> (+3 en Perception) repère les traces et les détails.</li><li><strong>Flamme purificatrice</strong> est gratuite et te rend de l'Endurance : utilise-la quand tu es à court.</li><li><strong>Ondulation de la Flamme en fleurs</strong> annule les dégâts d'une attaque et les renvoie !</li></ul>\n<h2>Tes formes de Souffle</h2><p>Elles <strong>touchent automatiquement</strong> (sauf si l'ennemi dépense un PR pour esquiver) et coûtent de l'Endurance (E).</p><table><tr><th>Forme</th><th>Nom</th><th>E</th><th>Dégâts</th><th>Portée</th><th>En clair</th></tr><tr><td>1</td><td><strong>Feu Inconscient</strong></td><td>2</td><td>3d6 + Force</td><td>1.5m / CàC</td><td>Une charge rapide qui vise le cou. Votre attaque de base au Souffle.</td></tr><tr><td>2</td><td><strong>Soleil Levant Brûlant</strong></td><td>3</td><td>1d20 + Finesse</td><td>1.5m / CàC</td><td>Une coupe montante, pas chère.</td></tr><tr><td>3</td><td><strong>Univers Flamboyant</strong></td><td>9</td><td>4d8 + Force</td><td>1.5m / CàC</td><td>Un grand coup horizontal très puissant.</td></tr><tr><td>4</td><td><strong>Ondulation de la Flamme en Fleurs</strong></td><td>4</td><td>1d12 + Finesse</td><td>1.5m / CàC</td><td>Votre lame tournoie et <strong>annule les dégâts</strong> d'une attaque, renvoyés sur une cible de votre choix.</td></tr><tr><td>5</td><td><strong>Tigre de Flamme</strong></td><td>11</td><td>2d8 + Force</td><td>9m</td><td>Un tigre de flammes qui frappe jusqu'à <strong>9 m</strong>.</td></tr><tr><td>7</td><td><strong>Flamme Purificatrice</strong></td><td>0</td><td>1d8 + Force ou Finesse</td><td>1.5m / CàC</td><td>Une posture de repos qui vous <strong>rend de l'Endurance</strong> selon les dégâts subis au tour précédent. Gratuite !</td></tr></table>\n<h2>Ton corbeau</h2><p>Gohan est un jeune corbeau goinfre qui adore Chiyo (elle partage toujours son repas).</p>\n<h2>Tes liens</h2><p>Itsuki est bourru, mais tu sens qu'il a bon cœur. Tu veux faire de Kenta un vrai guerrier.</p>\n<h2>Ton petit objectif secret</h2><p>Goûter les meilleurs dango de la vallée... et protéger au moins un villageois de tes propres mains.</p>\n<h2>Pour commencer</h2><blockquote><p>« On mange d'abord, on tranche ensuite ! ... Bon, d'accord, on tranche d'abord. »</p></blockquote>","format":1}},{"_id":"adfa11e9b27b0961","name":"Itsuki Kazahaya","sort":600,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/itsuki-kazahaya.webp\" width=\"160\" height=\"160\" alt=\"Portrait de Itsuki Kazahaya\" style=\"float:right;margin-left:1em\" /></p>\n<h2>Itsuki Kazahaya, 18 ans</h2>\n<p><em>Souffle du Vent — la colère qui protège</em> — fiche : @UUID[Actor.31438a3744a3964b]{Itsuki Kazahaya}</p>\n<h2>Qui tu es</h2><p>Tu as grandi dans un orphelinat de Yokohama. Un démon l'a attaqué quand tu avais douze ans ; tu as protégé les petits avec un bâton jusqu'à l'aube. Tu as une cicatrice sur la joue et une haine solide des démons. Ta maîtresse, une ancienne Hashira du Vent, t'a mis deux ans à te dompter.</p>\n<h2>Ta personnalité</h2><ul><li>Bourru, méfiant, parle peu.</li><li>Doux avec les enfants (mais ne le dira jamais).</li><li>Pour toi, un démon est un démon : pas de pitié.</li></ul>\n<h2>Ton rôle dans le groupe</h2><p>Tu es endurant (Courage 5, 25 Endurance) et tes formes coûtent peu. Ta posture du <strong>Vent Perçant</strong> te donne une attaque gratuite quand un ennemi te rate.</p>\n<p><strong>PV</strong> 20 · <strong>CA</strong> 12 · <strong>Endurance</strong> 25 · <strong>PR</strong> 8</p>\n<h2>Trois conseils</h2><ul><li>Ton <strong>toucher</strong> (+3 en Perception) te fait sentir les vibrations, les griffures, la chaleur.</li><li><strong>Coup de vent d'hiver</strong> est gratuit et te rend de l'Endurance.</li><li><strong>Griffe de vent purifiante</strong> frappe tous les ennemis proches.</li></ul>\n<h2>Tes formes de Souffle</h2><p>Elles <strong>touchent automatiquement</strong> (sauf si l'ennemi dépense un PR pour esquiver) et coûtent de l'Endurance (E).</p><table><tr><th>Forme</th><th>Nom</th><th>E</th><th>Dégâts</th><th>Portée</th><th>En clair</th></tr><tr><td>1</td><td><strong>Coupe-tourbillon de poussière</strong></td><td>1</td><td>1d10 + Force</td><td>4.5m</td><td>Une ruée en ligne droite dans un cyclone de coups. Pas chère.</td></tr><tr><td>2</td><td><strong>Griffe de Vent Purifiante</strong></td><td>2</td><td>1d12 + Force</td><td>1.5m / CàC</td><td>Quatre lames de vent qui frappent <strong>tous les ennemis à portée</strong>.</td></tr><tr><td>4</td><td><strong>Tempête de poussière montante</strong></td><td>2</td><td>3d6 + Force</td><td>1.5m / CàC</td><td>Des coups de lame dans toutes les directions. Très bon rapport puissance/prix.</td></tr><tr><td>5</td><td><strong>Coup de vent d'hiver</strong></td><td>0</td><td>1d6 + Finesse</td><td>1.5m / CàC</td><td>Une frappe en tombant qui <strong>vous rend de l'Endurance</strong>. Gratuite !</td></tr><tr><td>6</td><td><strong>Brume de la montagne du vent noir</strong></td><td>9</td><td>3d6 + Force</td><td>4.5m</td><td>Une tornade tranchante, puissante et à 4,5 m.</td></tr><tr><td>7</td><td><strong>Gale : rafale soudaine</strong></td><td>5</td><td>1d12 + Finesse</td><td>6m</td><td>Un saut et des vents violents jusqu'à 6 m.</td></tr></table>\n<h2>Ton corbeau</h2><p>Kuro est un vieux corbeau grincheux qui n'aime pas Itsuki. Ils se disputent tout le temps, mais Kuro revient toujours.</p>\n<h2>Tes liens</h2><p>Mizuki est trop gentille avec les démons, ça t'énerve. Tamaki mange des démons : ça te dégoûte, mais elle se bat bien.</p>\n<h2>Ton petit objectif secret</h2><p>À la fin, décider seul si ce démon mérite ta pitié. Ton personnage peut changer d'avis... ou pas.</p>\n<h2>Pour commencer</h2><blockquote><p>« Les enfants, restez derrière moi. Les démons, devant. »</p></blockquote>","format":1}},{"_id":"6a84b0ecbc90addc","name":"Tamaki Kurosu","sort":700,"ownership":{"default":-1},"flags":{},"title":{"show":true,"level":1},"system":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"type":"text","text":{"content":"<p><img src=\"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/tamaki-kurosu.webp\" width=\"160\" height=\"160\" alt=\"Portrait de Tamaki Kurosu\" style=\"float:right;margin-left:1em\" /></p>\n<h2>Tamaki Kurosu, 19 ans</h2>\n<p><em>Démoniste — elle mange les démons pour sauver les humains</em> — fiche : @UUID[Actor.3ffc020133c5e086]{Tamaki Kurosu}</p>\n<h2>Qui tu es</h2><p>Enfant, tu as travaillé dans une filature de coton. La poussière a abîmé tes poumons : tu ne pourras jamais apprendre un Souffle. Un vieux médecin du Corps t'a montré une autre voie : manger la chair des démons pour gagner leur force. Les autres pourfendeurs te regardent de travers. Tu t'en moques.</p>\n<h2>Ta personnalité</h2><ul><li>Pince-sans-rire, calme, un peu inquiétante.</li><li>Médecin dans l'âme : tu soignes tout le monde.</li><li>Tu caches ta bouche derrière un masque de tissu noir.</li></ul>\n<h2>Ton rôle dans le groupe</h2><p>Tu es la <strong>soigneuse</strong> et la <strong>tireuse</strong> du groupe. Ton fusil de tranchée fait très mal, et ta <strong>Maîtrise des armes à feu</strong> touche automatiquement une cible qui n'a pas dépensé de PR pendant ton tour.</p>\n<p><strong>PV</strong> 20 · <strong>CA</strong> 11 · <strong>Endurance</strong> 25 · <strong>PR</strong> 10 · <strong>BDP</strong> 6/15</p>\n<h2>Trois conseils</h2><ul><li>Tes <strong>Connaissances médicales</strong> : avec un bandage, tu soignes automatiquement 1d6+2 PV.</li><li>Quand un démon perd un morceau, <strong>mange-le</strong> (une action) pour gagner des BDP. Ton <strong>Estomac d'acier</strong> te donne un dé de plus. Tu commences avec 6 BDP.</li><li><strong>Tir en position stable</strong> : tu restes immobile et gagnes +8 au tir suivant.</li></ul>\n<h2>Tes armes et pouvoirs</h2><ul><li><strong>Fusil de tranchée</strong> : 3d6 + Précision, portée 15 m, 5 cartouches.</li><li><strong>Wakizashi Nichirin</strong> : lame courte pour achever les démons (vise la tête).</li><li><strong>Soin démoniaque</strong> : 4 BDP, une action, te soigne selon la chair de démon mangée récemment.</li><li><strong>Réaction de soin</strong> : 1 PR pour te soigner pendant le tour d'un autre.</li></ul>\n<h2>Ton corbeau</h2><p>Sumi est une jeune corneille curieuse qui apprécie Tamaki, même si elle trouve son régime alimentaire bizarre.</p>\n<h2>Tes liens</h2><p>Itsuki te déteste et tu trouves ça drôle. Mizuki est la seule à t'avoir demandé comment tu allais.</p>\n<h2>Ton petit objectif secret</h2><p>Sauver une vie grâce à ta méthode « dégoûtante », devant ceux qui te jugent.</p>\n<h2>Pour commencer</h2><blockquote><p>« Ne faites pas cette tête. Je ne mange que ceux qui le méritent. »</p></blockquote>","format":1}}],"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}],"scenes":[{"_id":"297d1308c2b940ce","name":"1. Hotaru-mura — le village des lucioles","navName":"Le village","active":false,"navigation":true,"navOrder":0,"thumb":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/maps/thumbs/hotaru-mura.webp","width":4000,"height":2800,"padding":0.1,"shiftX":0,"shiftY":0,"initial":{"x":2000,"y":1400,"scale":0.4},"initialLevel":"07381ab9f77a4177","grid":{"type":1,"size":100,"style":"solidLines","thickness":1,"color":"#000000","alpha":0.15,"distance":1.5,"units":"m"},"tokenVision":false,"fog":{"mode":0},"environment":{"darknessLevel":0,"darknessLock":false,"globalLight":{"enabled":false}},"levels":[{"_id":"07381ab9f77a4177","name":"Carte","elevation":{"bottom":0,"top":6},"background":{"src":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/maps/hotaru-mura.webp","color":"#000000","tint":"#ffffff","alphaThreshold":0.75},"foreground":{"src":null,"tint":"#ffffff","alphaThreshold":0.75},"fog":{"src":null},"textures":{"anchorX":0.5,"anchorY":0.5,"offsetX":0,"offsetY":0,"fit":"fill","scaleX":1,"scaleY":1,"rotation":0},"visibility":{"levels":[]},"sort":0,"flags":{}}],"notes":[{"_id":"24ce4994592bc2c2","entryId":"bc3c8fdd1a3d5b97","pageId":"776bd451877b54b3","x":150,"y":1400,"elevation":0,"levels":[],"sort":0,"locked":false,"texture":{"src":"icons/svg/book.svg","tint":"#f2c94c","anchorX":0.5,"anchorY":0.5,"fit":"contain"},"iconSize":48,"text":"Arrivée","fontFamily":"","fontSize":28,"textAnchor":1,"textColor":"#ffffff","global":false,"flags":{}},{"_id":"2e25b3fac3e681e1","entryId":"bc3c8fdd1a3d5b97","pageId":"c1622f08c79a04fb","x":1480,"y":1150,"elevation":0,"levels":[],"sort":1,"locked":false,"texture":{"src":"icons/svg/book.svg","tint":"#f2c94c","anchorX":0.5,"anchorY":0.5,"fit":"contain"},"iconSize":48,"text":"A. Auberge du Saule","fontFamily":"","fontSize":28,"textAnchor":1,"textColor":"#ffffff","global":false,"flags":{}},{"_id":"d227a71933b3b942","entryId":"bc3c8fdd1a3d5b97","pageId":"81bc107cb1d8e16d","x":990,"y":1700,"elevation":0,"levels":[],"sort":2,"locked":false,"texture":{"src":"icons/svg/book.svg","tint":"#f2c94c","anchorX":0.5,"anchorY":0.5,"fit":"contain"},"iconSize":48,"text":"B. Atelier d'Oume","fontFamily":"","fontSize":28,"textAnchor":1,"textColor":"#ffffff","global":false,"flags":{}},{"_id":"8d5ce8d5e2cc434c","entryId":"bc3c8fdd1a3d5b97","pageId":"53572b26cb75f0b7","x":3060,"y":750,"elevation":0,"levels":[],"sort":3,"locked":false,"texture":{"src":"icons/svg/book.svg","tint":"#f2c94c","anch