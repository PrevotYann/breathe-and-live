uilé percé de deux yeux bleus. Voix douce, polie, comme un enfant qui s'excuse. Il croit protéger ses captifs du froid et de la solitude. Il fuit la lumière du jour en se cachant dans le four de l'atelier. Tactique détaillée dans le guide du MJ.","loot":"Chair de démon (Rang élevé) pour le démoniste."},"supplement1934":{"enabled":false,"notes":""}},"items":[{"_id":"b6fad96d21f3246c","name":"Art de sang — Feu follet bleu","type":"bda","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/abilities/feu-follet-bleu.webp","system":{"tags":["bda","demon","oneshot","burn"],"description":"<p>Tomoshibi souffle sur une petite lanterne bleue qui file vers sa cible et éclate en flammes froides.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"action","quantity":1,"usageNote":"Jet de toucher (Finesse) contre la CA. Si ça touche : dégâts + Brûlure. Valeurs propres à ce scénario : le livre laisse au MJ le coût et les dégâts des arts de sang d'un démon inventé (dégâts calés sur le repère « Démon de rang élevé : BDA 1d6+3 »).","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":3,"demonisationGain":0,"damage":"1d6 + Finesse","range":9,"rangeText":"9 m","attackStat":"finesse","autoHit":false,"specialLines":["Applique Brûlure (1 dégât de feu par tour) si l'attaque touche."],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"burn","afflictionIntensity":1,"afflictionDuration":0,"markAsh":false,"noDamage":false,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false},"ruleSource":{"checkedAt":"2026-10-29","missingFields":["coût BDP","dégâts"],"approved":false,"scenario":true,"url":""},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"b06679e75a5b8b11","name":"Art de sang — Lueur d'oubli","type":"bda","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/abilities/lueur-d-oubli.webp","system":{"tags":["bda","demon","oneshot","charmed"],"description":"<p>Une lumière bleue, douce comme une veilleuse d'enfance. La cible oublie un instant pourquoi elle se bat.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"action","quantity":1,"usageNote":"Jet de toucher (Finesse) contre la CA. Si ça touche : état Charmé. Conseil MJ : une fois par round au maximum ; le charme se brise dès que le personnage charmé subit des dégâts ou à la fin de son prochain tour. Valeurs propres à ce scénario : le livre laisse au MJ le coût et les dégâts des arts de sang d'un démon inventé (dégâts calés sur le repère « Démon de rang élevé : BDA 1d6+3 »).","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":5,"demonisationGain":0,"damage":"1d4","range":9,"rangeText":"9 m","attackStat":"finesse","autoHit":false,"specialLines":["Applique Charmé si l'attaque touche (voir conseil MJ)."],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"charmed","afflictionIntensity":1,"afflictionDuration":1,"markAsh":false,"noDamage":false,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false},"ruleSource":{"checkedAt":"2026-10-29","missingFields":["coût BDP","dégâts","durée du charme"],"approved":false,"scenario":true,"url":""},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"14b3f93e7077c44f","name":"Art de sang — Lanterne-prison","type":"bda","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/lanterne-prison.webp","system":{"tags":["bda","demon","oneshot","imprisoned"],"description":"<p>Des feuilles de papier huilé s'enroulent autour de la cible et se referment en lanterne géante.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"action","quantity":1,"usageNote":"Jet de toucher (Finesse) contre la CA. Si ça touche : état Emprisonné. Pour se libérer : une action et un test de Force DD 13, ou un allié au contact coupe le papier (une action, réussite automatique). Valeurs propres à ce scénario : le livre laisse au MJ le coût et les dégâts des arts de sang d'un démon inventé (dégâts calés sur le repère « Démon de rang élevé : BDA 1d6+3 »).","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":6,"demonisationGain":0,"damage":"1d4","range":4.5,"rangeText":"4,5 m","attackStat":"finesse","autoHit":false,"specialLines":["Applique Emprisonné si l'attaque touche.","Libération : test de Force DD 13 ou un allié coupe le papier."],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"imprisoned","afflictionIntensity":1,"afflictionDuration":0,"markAsh":false,"noDamage":false,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false},"ruleSource":{"checkedAt":"2026-10-29","missingFields":["coût BDP","dégâts","condition de libération"],"approved":false,"scenario":true,"url":""},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"b231ae935d953b8e","name":"Nature — Le Lanternier","type":"demonAbility","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/tomoshibi.webp","system":{"tags":["demon","oneshot","passive","sadness"],"description":"<p>Tomoshibi était un garçon nommé Kansuke. Il a oublié presque tout, sauf la voix de la vieille Oume.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"passive","quantity":1,"usageNote":"Point faible narratif : si quelqu'un l'appelle « Kansuke » en lui rappelant sa vie d'avant (Oume, ou un PJ qui a lu son carnet), il doit réussir un test d'Endurance DD 15 (règle de l'état Triste) ou devenir Triste. Choix du scénario : un démon Triste perd sa prochaine action. Une seule fois par combat.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":0,"demonisationGain":0,"damage":"","range":0,"rangeText":"","attackStat":"","specialLines":[],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"","afflictionIntensity":1,"afflictionDuration":0,"markAsh":false,"noDamage":true,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false},"ruleSource":{"url":"","checkedAt":"","missingFields":[],"approved":false},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}},{"_id":"1fef4cd484a7b2fb","name":"Guerison demoniaque","type":"demonAbility","img":"icons/magic/life/cross-worn-green.webp","system":{"tags":["demon","shared-action","healing"],"description":"","sourceSection":"Classe de Demons","activation":"action","quantity":1,"usageNote":"Restaure les PV selon le rang demoniaque du lanceur.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":2,"demonisationGain":0,"damage":"","range":0,"rangeText":"","attackStat":"","specialLines":[],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"","afflictionIntensity":0,"markAsh":false,"noDamage":false,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false}},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.abilities-demons.Item.c6c378665b4a4186","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[]},{"_id":"a20ad02eff3eb7b4","name":"Repousse","type":"demonAbility","img":"icons/magic/life/root-vine-heart.webp","system":{"tags":["demon","shared-action","regen","mutilation"],"description":"","sourceSection":"Classe de Demons","activation":"action","quantity":1,"usageNote":"Regenerer immediatement les membres coches comme blesses, casses ou sectionnes dans la fiche.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"costBdp":4,"demonisationGain":0,"damage":"","range":0,"rangeText":"","attackStat":"","specialLines":[],"automation":{"area":"single","unlimitedRange":false,"cannotBeDodged":false,"cannotBeReactedTo":false,"afflictionCondition":"","afflictionIntensity":0,"markAsh":false,"noDamage":false,"delayedDamageRounds":0,"delayedDamageFormula":"","targetCapBase":0,"targetCapScalePerLevel":0,"summonFormula":"","teleportToBurned":false}},"flags":{},"_stats":{"compendiumSource":"Compendium.breathe-and-live.abilities-demons.Item.demSharedRegrow1","duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"effects":[]}],"effects":[],"folder":"4b52f7fd7baded99","sort":1500,"ownership":{"default":0},"flags":{"breathe-and-live":{"oneshot":"lanternes-hotaru"}},"prototypeToken":{"name":"Tomoshibi, le Lanternier","actorLink":true,"disposition":-1,"width":1,"height":1,"texture":{"src":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/tokens/tomoshibi.webp"},"displayName":30,"displayBars":40,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.bdp"},"sight":{"enabled":false}},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}],"items":[{"_id":"024498032613102b","name":"Lanterne bleue","type":"utility","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/items/lanterne-bleue.webp","system":{"tags":["oneshot","indice"],"description":"<p>Une petite lanterne en papier, d'un bleu profond qui ne ressemble à aucune teinture du marché. Elle est froide au toucher, même allumée. Une odeur d'huile brûlée et de sang s'en dégage.</p><p><b>Indice :</b> la vieille Oume reconnaît immédiatement ce bleu : c'est le « bleu de Kansuke », une teinture que seul son ancien apprenti savait préparer.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"passive","quantity":1,"usageNote":"Objet d'enquête, sans effet de jeu. Récupérée sur la rivière (Acte 2) ou près de la maison du charbonnier (Acte 1).","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"ruleSource":{"url":"","checkedAt":"","missingFields":[],"approved":false},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"folder":"81d17be2b6d8e84c","sort":100,"ownership":{"default":0}},{"_id":"a32f12eb5e164875","name":"Carnet brûlé de Kansuke","type":"utility","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/items/carnet-kansuke.webp","system":{"tags":["oneshot","indice"],"description":"<p>Un petit carnet aux bords noircis par le feu. Oume l'a gardé dix ans. Il contient des dessins de lanternes et quelques phrases d'un garçon très seul.</p><p>Voir l'aide de jeu « Carnet brûlé de Kansuke ».</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"passive","quantity":1,"usageNote":"Objet d'enquête. Un PJ qui l'a lu peut appeler le démon par son vrai nom (voir « Nature — Le Lanternier »).","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"ruleSource":{"url":"","checkedAt":"","missingFields":[],"approved":false},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"folder":"81d17be2b6d8e84c","sort":200,"ownership":{"default":0}},{"_id":"aa2b6412b19471f8","name":"Omamori de Mii","type":"utility","img":"systems/breathe-and-live/assets/oneshot/lanternes-hotaru/items/omamori-mii.webp","system":{"tags":["oneshot","roleplay"],"description":"<p>Un petit sachet de tissu rouge, cousu de travers. Mii l'a acheté au sanctuaire pour que son grand frère Sota revienne. Elle le donne au pourfendeur qui lui a promis de le ramener.</p>","sourceSection":"One-shot : Les Lanternes de Hotaru","activation":"passive","quantity":1,"usageNote":"Objet de roleplay sans effet de jeu. À l'épilogue, le rendre à Sota est un beau moment.","prerequisites":{"class":"","rank":"","breath":"","weapon":"","trait":"","sense":""},"uses":{"value":0,"max":0,"per":""},"effects":[],"selfEffects":[],"templates":["commonItem"],"ruleSource":{"url":"","checkedAt":"","missingFields":[],"approved":false},"supplement1934":{"enabled":false,"notes":""},"crafting":{"enabled":false,"componentCount":1,"dc":4,"stat":"sciences","resultItemName":"","consumedOnFailure":false,"notes":""}},"effects":[],"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.368","systemId":"breathe-and-live","systemVersion":"0.7.0","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"folder":"81d17be2b6d8e84c","sort":300,"ownership":{"default":0}},{"_id":"e1ed6b63e30627f7","name":"Bandage","type":"medical","img"