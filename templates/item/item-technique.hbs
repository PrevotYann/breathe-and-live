<form class="bl item-technique flexcol" autocomplete="off">
  <header class="sheet-header flexrow">
    <img class="profile" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Nom de la technique" />
      </h1>
      {{#if isSupplement1934Content}}
        <div class="muted"><small>Supplement 1934{{#unless supplement1934Global}} - optionnel, toggle global desactive{{/unless}}</small></div>
      {{/if}}
      <div class="flexrow gap">
        <div class="field small">
          <label>Famille / souffle</label>
          <input type="text" name="system.breath" value="{{system.breath}}" placeholder="Souffle, BDA, sous-classe..." />
        </div>
        <div class="field tiny">
          <label>Forme</label>
          <input type="number" name="system.form" value="{{system.form}}" min="0" />
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary" aria-label="Sections de la fiche">
    <a class="item" data-tab="stats"><i class="fas fa-chart-simple" aria-hidden="true"></i><span>Utilisation</span></a>
    <a class="item" data-tab="prereq"><i class="fas fa-list-check" aria-hidden="true"></i><span>Prérequis</span></a>
    <a class="item" data-tab="flags"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i><span>Effets</span></a>
    <a class="item" data-tab="tags"><i class="fas fa-tags" aria-hidden="true"></i><span>Références</span></a>
    <a class="item" data-tab="desc"><i class="fas fa-book-open" aria-hidden="true"></i><span>Description</span></a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="stats">
      <h2>Utilisation</h2><div class="grid four-col bl-cost-grid"><div class="field"><label>Endurance</label><input type="number" name="system.costE" value="{{system.costE}}" min="0" /></div><div class="field"><label>Réaction</label><input type="number" name="system.costRp" value="{{system.costRp}}" min="0" /></div><div class="field"><label>Sang démon</label><input type="number" name="system.costBdp" value="{{system.costBdp}}" min="0" /></div><div class="field"><label>Démonisation</label><input type="number" name="system.demonisationGain" value="{{system.demonisationGain}}" min="0" step="0.5" /></div></div>
<h3>Résolution</h3>
      <div class="grid two-col">








        <label>Degats</label>
        <input type="text" name="system.damage" value="{{system.damage}}" placeholder="ex: 2d8 + Force" />



        <label>Portee (m)</label>
        <input type="number" name="system.range" value="{{system.range}}" min="0" step="0.5" />





        <label>Stat d'attaque</label>
        <input type="text" name="system.attackStat" value="{{system.attackStat}}" placeholder="force / finesse / precision" />

        <label>Auto-hit</label>
        <input type="checkbox" name="system.autoHit" data-dtype="Boolean" {{checked system.autoHit}} />





        <label>Activation</label>
        <input type="text" name="system.activation" value="{{system.activation}}" placeholder="action / reaction / passive" />

      </div>
    <details class="bl-disclosure"><summary>Précisions de résolution</summary><div class="grid bl-label-grid"><label>Texte Degats</label>
        <textarea name="system.damageText" rows="3">{{system.damageText}}</textarea><label>Portee (texte)</label>
        <input type="text" name="system.rangeText" value="{{system.rangeText}}" placeholder="ex: 4.5m / CàC" /><label>Modificateur</label>
        <input type="text" name="system.modifierText" value="{{system.modifierText}}" placeholder="Force / Finesse / Precision..." /></div></details></div>

    <div class="tab" data-group="primary" data-tab="prereq">
      <h2>Prérequis et usage</h2>
      <div class="grid two-col">
        <label>Prerequis classe</label>
        <input type="text" name="system.prerequisites.class" value="{{system.prerequisites.class}}" />

        <label>Prerequis rang</label>
        <input type="text" name="system.prerequisites.rank" value="{{system.prerequisites.rank}}" />

        <label>Prerequis sens</label>
        <input type="text" name="system.prerequisites.sense" value="{{system.prerequisites.sense}}" />

        <label>Prerequis arme</label>
        <input type="text" name="system.prerequisites.weapon" value="{{system.prerequisites.weapon}}" />

        <label>Prerequis trait</label>
        <input type="text" name="system.prerequisites.trait" value="{{system.prerequisites.trait}}" />

        <label>Note d'usage</label>
        <textarea name="system.usageNote" rows="3">{{system.usageNote}}</textarea>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="flags">
      <div class="grid two-col">
        <label><input type="checkbox" name="system.flags.aoe" data-dtype="Boolean" {{checked system.flags.aoe}} /> Zone</label>
        <label><input type="checkbox" name="system.flags.antiFriendlyFire" data-dtype="Boolean" {{checked system.flags.antiFriendlyFire}} /> Pas de tir ami</label>
        <label><input type="checkbox" name="system.flags.mobility" data-dtype="Boolean" {{checked system.flags.mobility}} /> Mobilite</label>
        <label><input type="checkbox" name="system.flags.decapitation" data-dtype="Boolean" {{checked system.flags.decapitation}} /> Decapitation</label>
        <label><input type="checkbox" name="system.flags.regenerator" data-dtype="Boolean" {{checked system.flags.regenerator}} /> Regenerateur</label>
        <label><input type="checkbox" name="system.flags.affliction" data-dtype="Boolean" {{checked system.flags.affliction}} /> Affliction</label>
        <label><input type="checkbox" name="system.flags.pursuer" data-dtype="Boolean" {{checked system.flags.pursuer}} /> Poursuivant</label>
        <label><input type="checkbox" name="system.flags.sweep" data-dtype="Boolean" {{checked system.flags.sweep}} /> Fauchage</label>
        <label>Charge (tours)</label>
        <input type="number" name="system.flags.charge" value="{{system.flags.charge}}" min="0" />

      </div>
<details class="bl-disclosure"><summary>Construction d’un souffle maison</summary><div class="grid bl-label-grid">        <label>Creation maison</label>
        <input type="checkbox" name="system.customBreath.enabled" data-dtype="Boolean" {{checked system.customBreath.enabled}} />

        <label>Cle degats maison</label>
        <input type="text" name="system.customBreath.damageKey" value="{{system.customBreath.damageKey}}" />

        <label>Cle portee maison</label>
        <input type="text" name="system.customBreath.rangeKey" value="{{system.customBreath.rangeKey}}" />

        <label>Cle effet maison</label>
        <input type="text" name="system.customBreath.effectKey" value="{{system.customBreath.effectKey}}" />

        <label>Cout brut maison</label>
        <input type="number" name="system.customBreath.rawCost" value="{{system.customBreath.rawCost}}" />
</div></details>
      <p class="hint">Les tableaux <code>system.effects</code> et <code>system.selfEffects</code> restent editables via JSON/compendium pour les cas avances.</p>
    </div>

    <div class="tab" data-group="primary" data-tab="tags">
      <h2>Références</h2>
      <div class="grid two-col"><label>Source</label>
        <input type="text" name="system.sourceSection" value="{{system.sourceSection}}" placeholder="Regle / section du livre" />
<label>Supplement 1934</label>
        <input type="checkbox" name="system.supplement1934.enabled" data-dtype="Boolean" {{checked system.supplement1934.enabled}} /></div>
      <h3>Tags</h3>
      <label>Tags</label>
      <textarea name="system.tagsText" rows="3" placeholder="tags separes par des virgules">{{join system.tags ", "}}</textarea>
    </div>

    <div class="tab" data-group="primary" data-tab="desc">
      {{editor system.description target="system.description" button=true owner=owner editable=editable}}
    </div>
  </section>
</form>
