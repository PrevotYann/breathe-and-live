<form class="bl actor-slayer {{#unless canEdit}}bl-readonly{{/unless}}" data-actor-type="{{actor.type}}" autocomplete="off">
  {{> "systems/breathe-and-live/templates/actor/parts/header.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary" aria-label="Sections de la fiche">
    <a class="item" data-tab="fiche"><i class="fas fa-scroll" aria-hidden="true"></i><span>Fiche</span></a>
    <a class="item" data-tab="techniques"><i class="fas fa-burst" aria-hidden="true"></i><span>Techniques</span></a>
    <a class="item" data-tab="breaths"><i class="fas fa-wind" aria-hidden="true"></i><span>Souffles</span></a>
    <a class="item" data-tab="inventaire"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span>Sac</span></a>
    <a class="item" data-tab="regles"><i class="fas fa-heart-pulse" aria-hidden="true"></i><span>Santé</span></a>
    <a class="item" data-tab="dossier"><i class="fas fa-feather" aria-hidden="true"></i><span>Dossier</span></a>
    <a class="item" data-tab="progression"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i><span>Progression</span></a>
    <a class="item" data-tab="creation"><i class="fas fa-user-plus" aria-hidden="true"></i><span>Création</span></a>
    <a class="item" data-tab="reference"><i class="fas fa-book-open" aria-hidden="true"></i><span>Règles</span></a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="fiche">
      <div class="bl-fiche">
        {{> "systems/breathe-and-live/templates/actor/parts/stats.hbs"}}
        <div class="bl-fiche-main">
          {{> "systems/breathe-and-live/templates/actor/parts/resources.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/weapons.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/technique-sheet.hbs"}}
        </div>
      </div>
      <section class="bl-combat-panel" aria-label="Actions">
        <h3>Actions</h3>
        <div class="bl-combat-shortcuts">
          <button type="button" class="bl-action-basic-attack"><i class="fas fa-khanda" aria-hidden="true"></i> Attaque de base</button>
          <button type="button" class="bl-action-sprint"><i class="fas fa-person-running" aria-hidden="true"></i> Sprinter</button>
          <button type="button" class="bl-action-wait"><i class="fas fa-hourglass-half" aria-hidden="true"></i> Attendre</button>
          <button type="button" class="bl-action-rest"><i class="fas fa-moon" aria-hidden="true"></i> Repos</button>
        </div>
        <details class="bl-action-drawer">
          <summary>Réactions &amp; soutien</summary>
          <div class="bl-action-grid">
            <button type="button" class="bl-action-counter">Riposte <small>1 RP</small></button>
            <button type="button" class="bl-action-counter-assured">Coup assuré <small>2 RP</small></button>
            <button type="button" class="bl-action-draw">Dégainage <small>1 RP</small></button>
            <button type="button" class="bl-action-draw-attack">Dégainage + attaque <small>2 RP</small></button>
            <button type="button" class="bl-action-assistance">Assistance</button>
            <button type="button" class="bl-action-kakushi">Kakushi</button>
          </div>
        </details>
      </section>
      {{> "systems/breathe-and-live/templates/actor/parts/status.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="techniques">
      {{> "systems/breathe-and-live/templates/actor/parts/technique-list.hbs" showBreathBuilder=true}}
    </div>

    <div class="tab" data-group="primary" data-tab="breaths">
      <div class="bl-toolbar">
        <h2 class="bl-ink-title">Souffles</h2>
        {{#if canEdit}}
          <button type="button" class="bl-custom-breath-builder bl-stamp"><i class="fas fa-pen-nib" aria-hidden="true"></i> Calculateur de souffle maison</button>
          <button type="button" class="bl-mist-hide bl-stamp"><i class="fas fa-smog" aria-hidden="true"></i> Brume : se cacher / sortir</button>
        {{/if}}
      </div>
      <div class="breath-card-list">
        {{#each ownedBreathItems as |it|}}
          <article class="breath-card item {{#if it.actorEnabled}}is-active{{/if}}" data-item-id="{{it.id}}">
            <img class="breath-card__img" src="{{it.img}}" alt="" />
            <div class="breath-card__body">
              <div class="breath-card__topline">
                <a class="item-edit">{{it.name}}</a>
                <span class="tag {{#if it.actorEnabled}}tag--seal{{/if}}">{{#if it.actorEnabled}}Actif{{else}}Inactif{{/if}}</span>
              </div>
              {{#if it.sourceSection}}<small>{{it.sourceSection}}</small>{{/if}}
              {{#if it.prereqText}}<p><strong>Prérequis :</strong> {{it.prereqText}}</p>{{/if}}
              {{#if it.itemSpecials.length}}<div class="tag-row">{{#each it.itemSpecials as |special|}}<span class="tag">{{special}}</span>{{/each}}</div>{{/if}}
              {{#if it.description}}<details class="bl-disclosure"><summary>Description</summary><p>{{it.description}}</p></details>{{/if}}
            </div>
            <div class="controls">
              <a class="item-control item-edit" title="Ouvrir"><i class="fas fa-pen-to-square"></i></a>
              <a class="item-control item-delete" title="Supprimer"><i class="fas fa-trash"></i></a>
            </div>
          </article>
        {{else}}
          <p class="hint">Aucun souffle. Glissez un style depuis le compendium « Souffles - Styles ».</p>
        {{/each}}
      </div>

      <h3>Maîtrises avancées</h3>
      <div class="bl-seal-grid">
        {{#each advancedStateEntries as |state|}}
          <label class="bl-seal {{#if state.active}}is-active{{/if}}" title="{{state.note}}">
            <input type="checkbox" name="system.states.{{state.key}}" data-dtype="Boolean" {{checked state.active}} {{#unless ../canEdit}}disabled{{/unless}} />
            <strong>{{state.label}}</strong>
            <small>{{state.note}}</small>
          </label>
        {{/each}}
      </div>

      <details class="bl-disclosure">
        <summary>Activer les souffles et leurs passifs</summary>
        <div class="breath-toggle-grid">
          {{#each breathEntries as |entry|}}
            <div class="bl-breath-toggle">
              <label><input type="checkbox" name="system.breaths.{{entry.key}}.enabled" data-dtype="Boolean" {{checked entry.enabled}} {{#unless ../canEdit}}disabled{{/unless}} /> <strong>{{entry.label}}</strong></label>
              {{#each entry.specialEntries as |special|}}
                <label class="small" title="{{special.hint}}"><input type="checkbox" name="system.breaths.{{../key}}.specials.{{special.key}}" data-dtype="Boolean" {{checked special.enabled}} {{#unless ../../canEdit}}disabled{{/unless}} /> {{special.label}}</label>
              {{/each}}
            </div>
          {{/each}}
        </div>
      </details>
    </div>

    <div class="tab" data-group="primary" data-tab="inventaire">
      {{> "systems/breathe-and-live/templates/actor/parts/inventory.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="regles">
      {{> "systems/breathe-and-live/templates/actor/parts/health.hbs" showLimbNotes=true}}
    </div>

    <div class="tab" data-group="primary" data-tab="dossier">
      {{> "systems/breathe-and-live/templates/actor/parts/dossier.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="progression">
      {{> "systems/breathe-and-live/templates/actor/parts/progression.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="creation">
      {{> "systems/breathe-and-live/templates/actor/parts/creation.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="reference">
      {{> "systems/breathe-and-live/templates/actor/parts/combat-rules.hbs"}}
    </div>
  </section>
</form>
