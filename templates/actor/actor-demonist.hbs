<form class="bl actor-demonist {{#unless canEdit}}bl-readonly{{/unless}}" data-actor-type="{{actor.type}}" autocomplete="off">
  {{> "systems/breathe-and-live/templates/actor/parts/header.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary" aria-label="Sections de la fiche">
    <a class="item" data-tab="fiche"><i class="fas fa-scroll" aria-hidden="true"></i><span>Fiche</span></a>
    <a class="item" data-tab="techniques"><i class="fas fa-burst" aria-hidden="true"></i><span>Techniques</span></a>
    <a class="item" data-tab="demonism"><i class="fas fa-droplet" aria-hidden="true"></i><span>Démonisme</span></a>
    <a class="item" data-tab="inventaire"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span>Sac</span></a>
    <a class="item" data-tab="regles"><i class="fas fa-heart-pulse" aria-hidden="true"></i><span>Santé</span></a>
    <a class="item" data-tab="dossier"><i class="fas fa-feather" aria-hidden="true"></i><span>Dossier</span></a>
    <a class="item" data-tab="progression"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i><span>Progression</span></a>
    <a class="item" data-tab="creation"><i class="fas fa-user-plus" aria-hidden="true"></i><span>Création</span></a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="fiche">
      <div class="bl-fiche">
        {{> "systems/breathe-and-live/templates/actor/parts/stats.hbs"}}
        <div class="bl-fiche-main">
          {{> "systems/breathe-and-live/templates/actor/parts/resources.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/weapons.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/technique-sheet.hbs"}}
        </div>
      </div>
      <section class="bl-combat-panel" aria-label="Actions">
        <h3>Actions</h3>
        <div class="bl-combat-shortcuts">
          <button type="button" class="bl-action-basic-attack"><i class="fas fa-khanda" aria-hidden="true"></i> Attaque de base</button>
          <button type="button" class="bl-action-demonist-heal"><i class="fas fa-heart-pulse" aria-hidden="true"></i> Soin <small>1 RP</small></button>
          <button type="button" class="bl-action-recovery"><i class="fas fa-wind" aria-hidden="true"></i> Récupération</button>
          <button type="button" class="bl-action-rest"><i class="fas fa-moon" aria-hidden="true"></i> Repos</button>
        </div>
        <details class="bl-action-drawer">
          <summary>Toutes les actions</summary>
          <div class="bl-action-grid">
            <button type="button" class="bl-action-repeated-attack">Action répétée</button>
            <button type="button" class="bl-action-demonist-heal-max">Soin max <small>2 RP</small></button>
            <button type="button" class="bl-action-demonist-enhance">Amélioration <small>RP</small></button>
            <button type="button" class="bl-action-sprint">Sprinter</button>
            <button type="button" class="bl-action-wait">Attendre</button>
            <button type="button" class="bl-action-counter">Riposte <small>1 RP</small></button>
            <button type="button" class="bl-action-counter-assured">Coup assuré <small>2 RP</small></button>
            <button type="button" class="bl-action-draw">Dégainage <small>1 RP</small></button>
            <button type="button" class="bl-action-draw-attack">Dégainage + attaque <small>2 RP</small></button>
            <button type="button" class="bl-action-assistance">Assistance</button>
            <button type="button" class="bl-action-kakushi">Kakushi</button>
          </div>
        </details>
      </section>
      {{> "systems/breathe-and-live/templates/actor/parts/status.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="techniques">
      {{> "systems/breathe-and-live/templates/actor/parts/technique-list.hbs" showBreathBuilder=true}}
    </div>

    <div class="tab" data-group="primary" data-tab="demonism">
      <h2 class="bl-ink-title">Sang &amp; soins démonistes</h2>
      <div class="bl-seal-grid">
        <label class="bl-seal {{#if system.support.demonistHealingReaction}}is-active{{/if}}">
          <input type="checkbox" name="system.support.demonistHealingReaction" data-dtype="Boolean" {{checked system.support.demonistHealingReaction}} {{#unless canEdit}}disabled{{/unless}} />
          <strong>Réaction de soin démoniste</strong>
          <small>Guérison démoniaque par rang de la chair consommée.</small>
        </label>
        <label class="bl-seal {{#if system.support.activeDemonistMedicine}}is-active{{/if}}">
          <input type="checkbox" name="system.support.activeDemonistMedicine" data-dtype="Boolean" {{checked system.support.activeDemonistMedicine}} {{#unless canEdit}}disabled{{/unless}} />
          <strong>Médecine active démoniste</strong>
          <small>Démonisation gagnée réduite de 50 % jusqu'à la fin du combat.</small>
        </label>
      </div>
      <div class="bl-ledger-grid">
        <label class="bl-line"><span>Chair récente (rang)</span><input type="text" name="system.support.recentDemonFleshRank" value="{{system.support.recentDemonFleshRank}}" {{#unless canEdit}}disabled{{/unless}} /></label>
      </div>
      <div class="rule-pills">
        <div class="rule-pill"><span>Démonisation</span><strong>{{system.resources.demonisation}} / {{system.resources.demonisationMax}}</strong></div>
        <div class="rule-pill"><span>BDP</span><strong>{{system.resources.bdp.value}} / {{system.resources.bdp.max}}</strong></div>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="inventaire">
      {{> "systems/breathe-and-live/templates/actor/parts/inventory.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="regles">
      {{> "systems/breathe-and-live/templates/actor/parts/health.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="dossier">
      {{> "systems/breathe-and-live/templates/actor/parts/dossier.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="progression">
      {{> "systems/breathe-and-live/templates/actor/parts/progression.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="creation">
      {{> "systems/breathe-and-live/templates/actor/parts/creation.hbs"}}
    </div>
  </section>
</form>
