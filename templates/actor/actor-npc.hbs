<form class="bl actor-npc {{#unless canEdit}}bl-readonly{{/unless}}" data-actor-type="{{actor.type}}" autocomplete="off">
  {{> "systems/breathe-and-live/templates/actor/parts/header.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary" aria-label="Sections de la fiche">
    <a class="item" data-tab="fiche"><i class="fas fa-scroll" aria-hidden="true"></i><span>Fiche</span></a>
    <a class="item" data-tab="techniques"><i class="fas fa-burst" aria-hidden="true"></i><span>Techniques</span></a>
    <a class="item" data-tab="regles"><i class="fas fa-heart-pulse" aria-hidden="true"></i><span>Santé</span></a>
    <a class="item" data-tab="profile"><i class="fas fa-id-card" aria-hidden="true"></i><span>Profil</span></a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="fiche">
      <div class="bl-statblock {{#if showBdp}}bl-statblock--demon{{/if}}">
        <div class="bl-sb-row bl-sb-top">
          <div class="bl-sb-cell bl-sb-resource" style="--pct: {{meters.hp}}%"><span class="bl-sb-head">PV</span>
            <span class="pair"><input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}" aria-label="PV actuels" {{#unless canEdit}}disabled{{/unless}} /><span>/</span><input type="number" name="system.resources.hp.max" value="{{system.resources.hp.max}}" aria-label="PV maximum" {{#unless canEdit}}disabled{{/unless}} /></span>
          </div>
          <div class="bl-sb-cell"><span class="bl-sb-head">CA</span>
            <input type="number" name="system.resources.ca" value="{{system.resources.ca}}" aria-label="Classe d'armure" {{#unless canEdit}}disabled{{/unless}} />
          </div>
          <div class="bl-sb-cell bl-sb-title"><strong>{{actor.name}}</strong><em>{{system.class.rank}}{{#if system.npc.role}} · {{system.npc.role}}{{/if}}</em></div>
        </div>
        <div class="bl-sb-row bl-sb-stats">
          {{#each statBlocks as |stat|}}
            <div class="bl-sb-cell">
              <button type="button" class="bl-sb-head bl-roll-base" data-stat="{{stat.key}}" data-label="{{stat.label}}" title="Test de {{stat.label}}">{{stat.label}}</button>
              <input type="number" name="system.stats.base.{{stat.key}}" value="{{stat.value}}" aria-label="{{stat.label}}" {{#unless ../canEdit}}disabled{{/unless}} />
            </div>
          {{/each}}
        </div>
        <div class="bl-sb-row bl-sb-split">
          <div class="bl-sb-cell bl-sb-attacks"><span class="bl-sb-head">Attaques</span>
            <ol class="bl-sb-list">
              {{#each demonQuickAttacks as |it|}}
                <li><button type="button" class="bl-demon-basic-attack bl-sb-roll" data-item-id="{{it.itemId}}" data-attack-key="{{it.key}}" data-attack-name="{{it.name}}" data-attack-damage="{{it.damage}}" data-attack-range="{{it.range}}">{{it.name}}</button> <span>{{#if it.damage}}{{it.damage}}{{else}}—{{/if}}</span></li>
              {{/each}}
              {{#each itemsWeapons as |it|}}
                <li class="item" data-item-id="{{it.id}}"><button type="button" class="bl-weapon-attack bl-sb-roll">{{it.name}}</button> <span>{{it.system.damage}}</span></li>
              {{/each}}
              {{#each itemsTechUsable as |it|}}
                <li class="item" data-item-id="{{it.id}}"><button type="button" class="item-chat bl-sb-roll">{{#if it.system.form}}Forme {{it.system.form}} : {{/if}}{{it.name}}</button> <span>{{#if it.system.damage}}{{it.system.damage}}{{/if}}{{#if it.blCost}} · {{it.blCost}}{{/if}}</span></li>
              {{/each}}
              {{#unless demonQuickAttacks.length}}{{#unless itemsWeapons.length}}{{#unless itemsTechUsable.length}}
                <li><button type="button" class="bl-action-basic-attack bl-sb-roll">Attaque de base</button> <span>{{system.combat.basicAttack.unarmedDamage}}</span></li>
              {{/unless}}{{/unless}}{{/unless}}
            </ol>
          </div>
          <div class="bl-sb-cell bl-sb-reactions">
            <span class="bl-sb-head">Points de réaction</span>
            <span class="pair"><input type="number" name="system.resources.rp.value" value="{{system.resources.rp.value}}" aria-label="Points de réaction actuels" {{#unless canEdit}}disabled{{/unless}} /><span>/</span><input type="number" name="system.resources.rp.max" value="{{system.resources.rp.max}}" aria-label="Points de réaction maximum" {{#unless canEdit}}disabled{{/unless}} /></span>
            {{#if showEndurance}}
              <span class="bl-sb-head">Endurance</span>
              <span class="pair"><input type="number" name="system.resources.e.value" value="{{system.resources.e.value}}" aria-label="Endurance actuelle" {{#unless canEdit}}disabled{{/unless}} /><span>/</span><input type="number" name="system.resources.e.max" value="{{system.resources.e.max}}" aria-label="Endurance maximum" {{#unless canEdit}}disabled{{/unless}} /></span>
            {{/if}}
            {{#if showBdp}}
              <span class="bl-sb-head">BDP</span>
              <span class="pair"><input type="number" name="system.resources.bdp.value" value="{{system.resources.bdp.value}}" aria-label="BDP actuels" {{#unless canEdit}}disabled{{/unless}} /><span>/</span><input type="number" name="system.resources.bdp.max" value="{{system.resources.bdp.max}}" aria-label="BDP maximum" {{#unless canEdit}}disabled{{/unless}} /></span>
            {{/if}}
          </div>
        </div>
        <div class="bl-sb-row">
          <div class="bl-sb-cell bl-sb-abilities"><span class="bl-sb-head">Capacités</span>
            {{#each itemsTechPassive as |it|}}
              <p class="item" data-item-id="{{it.id}}"><a class="item-edit"><strong>{{it.name}} :</strong></a> {{#if it.system.usageNote}}{{it.system.usageNote}}{{else}}{{it.system.breathDisplay}}{{/if}}</p>
            {{else}}
              <p><small>Aucune capacité passive.</small></p>
            {{/each}}
          </div>
        </div>
      </div>

      <section class="bl-combat-panel" aria-label="Actions">
        <div class="bl-combat-shortcuts">
          <button type="button" class="bl-action-basic-attack"><i class="fas fa-khanda" aria-hidden="true"></i> Attaque de base</button>
          <button type="button" class="bl-action-rest"><i class="fas fa-moon" aria-hidden="true"></i> Repos</button>
        </div>
        <details class="bl-action-drawer">
          <summary>Toutes les actions</summary>
          <div class="bl-action-grid">
            <button type="button" class="bl-action-sprint">Sprinter</button>
            <button type="button" class="bl-action-wait">Attendre</button>
            <button type="button" class="bl-action-assistance">Assistance</button>
            <button type="button" class="bl-action-kakushi">Kakushi</button>
            <button type="button" class="bl-action-counter">Riposte <small>1 RP</small></button>
            <button type="button" class="bl-action-counter-assured">Coup assuré <small>2 RP</small></button>
          </div>
        </details>
      </section>
      {{> "systems/breathe-and-live/templates/actor/parts/status.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="techniques">
      {{> "systems/breathe-and-live/templates/actor/parts/technique-list.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="regles">
      {{#if isNpcDemon}}
        <h2 class="bl-ink-title">Actions démoniaques</h2>
        {{> "systems/breathe-and-live/templates/actor/parts/demon-actions.hbs"}}
      {{/if}}
      {{> "systems/breathe-and-live/templates/actor/parts/health.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="profile">
      <div class="bl-ledger-grid">
        <label class="bl-line"><span>Rôle</span><input type="text" name="system.npc.role" value="{{system.npc.role}}" {{#unless canEdit}}disabled{{/unless}} /></label>
      </div>
      <div class="bl-two">
        <label class="bl-field"><span>Comportement</span>
          <textarea class="bl-lined" name="system.npc.behavior" rows="4" {{#unless canEdit}}disabled{{/unless}}>{{system.npc.behavior}}</textarea>
        </label>
        <label class="bl-field"><span>Butin</span>
          <textarea class="bl-lined" name="system.npc.loot" rows="4" {{#unless canEdit}}disabled{{/unless}}>{{system.npc.loot}}</textarea>
        </label>
        <label class="bl-field"><span>Conditions libres</span>
          <textarea class="bl-lined" name="system.combat.injuries.conditions" rows="3" {{#unless canEdit}}disabled{{/unless}}>{{system.combat.injuries.conditions}}</textarea>
        </label>
      </div>
      {{#if isNpcDemon}}
        {{> "systems/breathe-and-live/templates/actor/parts/demon-body.hbs"}}
        <h3>Repères du bestiaire</h3>
        {{> "systems/breathe-and-live/templates/actor/parts/benchmark.hbs"}}
      {{/if}}
    </div>
  </section>
</form>
