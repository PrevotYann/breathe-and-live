<form class="bl actor-demon {{#unless canEdit}}bl-readonly{{/unless}}" data-actor-type="{{actor.type}}" autocomplete="off">
  {{> "systems/breathe-and-live/templates/actor/parts/header.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary" aria-label="Sections de la fiche">
    <a class="item" data-tab="fiche"><i class="fas fa-scroll" aria-hidden="true"></i><span>Fiche</span></a>
    <a class="item" data-tab="techniques"><i class="fas fa-burst" aria-hidden="true"></i><span>Arts démoniaques</span></a>
    <a class="item" data-tab="body"><i class="fas fa-dna" aria-hidden="true"></i><span>Corps</span></a>
    <a class="item" data-tab="inventaire"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span>Sac</span></a>
    <a class="item" data-tab="health"><i class="fas fa-heart-pulse" aria-hidden="true"></i><span>Santé</span></a>
    <a class="item" data-tab="regles"><i class="fas fa-book-open" aria-hidden="true"></i><span>Références</span></a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="fiche">
      <div class="bl-fiche">
        {{> "systems/breathe-and-live/templates/actor/parts/stats.hbs"}}
        <div class="bl-fiche-main">
          {{> "systems/breathe-and-live/templates/actor/parts/resources.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/natural-attacks.hbs"}}
          {{> "systems/breathe-and-live/templates/actor/parts/technique-sheet.hbs" sheetTitle="Arts démoniaques"}}
        </div>
      </div>
      <section class="bl-combat-panel" aria-label="Actions">
        <h3>Actions</h3>
        <div class="bl-combat-shortcuts">
          <button type="button" class="bl-action-basic-attack"><i class="fas fa-paw" aria-hidden="true"></i> Attaque de base</button>
          <button type="button" class="bl-action-sprint"><i class="fas fa-person-running" aria-hidden="true"></i> Sprinter</button>
          <button type="button" class="bl-action-rest"><i class="fas fa-moon" aria-hidden="true"></i> Repos</button>
        </div>
        <details class="bl-action-drawer">
          <summary>Toutes les actions</summary>
          <div class="bl-action-grid">
            <button type="button" class="bl-action-wait">Attendre</button>
            <button type="button" class="bl-action-counter">Riposte <small>1 RP</small></button>
            <button type="button" class="bl-action-counter-assured">Coup assuré <small>2 RP</small></button>
          </div>
        </details>
      </section>
      {{> "systems/breathe-and-live/templates/actor/parts/status.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="techniques">
      {{> "systems/breathe-and-live/templates/actor/parts/technique-list.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="body">
      {{> "systems/breathe-and-live/templates/actor/parts/demon-body.hbs"}}
      <section>
        <h3>Palier du rang</h3>
        {{#if demonRankPackage}}
          <div class="stat-benchmark-grid">
            {{#each demonRankPackageLabels as |row|}}<div class="benchmark-chip"><span>{{row.label}}</span><strong>+{{row.value}}</strong></div>{{/each}}
          </div>
        {{else}}
          <p class="hint">Aucun paquet de rang connu pour ce démon.</p>
        {{/if}}
      </section>
      <textarea class="bl-lined" name="system.progression.notes" rows="3" placeholder="Notes sur le corps, la lignée…" aria-label="Notes" {{#unless canEdit}}disabled{{/unless}}>{{system.progression.notes}}</textarea>
      <details class="bl-disclosure">
        <summary>Rappels de règles</summary>
        <div class="rule-pills">
          <div class="rule-pill"><span>Création</span><strong>0 / 1 / 2 / 3 / 3 / 5 + rang</strong></div>
          <div class="rule-pill"><span>PV</span><strong>Corps + (5 × Force)</strong></div>
          <div class="rule-pill"><span>BDP</span><strong>10 × Courage</strong></div>
          <div class="rule-pill"><span>RP</span><strong>(5 + Vit + Int) / 2</strong></div>
          <div class="rule-pill"><span>Endurance</span><strong>Aucune pour les démons</strong></div>
          <div class="rule-pill"><span>Dégâts de stat</span><strong>Force / Finesse à moitié</strong></div>
        </div>
      </details>
    </div>

    <div class="tab" data-group="primary" data-tab="inventaire">
      {{> "systems/breathe-and-live/templates/actor/parts/inventory.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="health">
      {{> "systems/breathe-and-live/templates/actor/parts/health.hbs"}}
    </div>

    <div class="tab" data-group="primary" data-tab="regles">
      <div class="bl-two">
        <section>
          <h2 class="bl-ink-title">Bestiaire</h2>
          <p class="hint">Repères du livre pour un démon de ce rang. Ils ne remplacent pas les formules de la fiche.</p>
          {{> "systems/breathe-and-live/templates/actor/parts/benchmark.hbs"}}
        </section>
        <section>
          <h2 class="bl-ink-title">Actions démoniaques</h2>
          {{> "systems/breathe-and-live/templates/actor/parts/demon-actions.hbs"}}
        </section>
      </div>
    </div>
  </section>
</form>
