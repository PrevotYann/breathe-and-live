<div class="bl-health">
  <section class="bl-conditions" aria-label="Conditions">
    <h2 class="bl-ink-title">Conditions</h2>
    <p class="hint">Cochez pour appliquer. Intensité et tours restants à droite.</p>
    {{#if conditionAutomationNotes.length}}<small>{{join conditionAutomationNotes " | "}}</small>{{/if}}
    <div class="condition-list">
      {{#each conditionEntries as |entry|}}
        <div class="condition-row {{#if entry.state.active}}is-active{{/if}}" title="{{entry.note}}">
          <label>
            <input type="checkbox" name="system.conditions.{{entry.key}}.active" data-dtype="Boolean" {{checked entry.state.active}} {{#unless ../canEdit}}disabled{{/unless}} />
            {{entry.label}}
          </label>
          <input type="number" aria-label="{{entry.label}} — intensité" title="Intensité" name="system.conditions.{{entry.key}}.intensity" value="{{entry.state.intensity}}" min="0" placeholder="Niv." {{#unless ../canEdit}}disabled{{/unless}} />
          <input type="number" aria-label="{{entry.label}} — durée en tours" title="Tours restants" name="system.conditions.{{entry.key}}.duration" value="{{entry.state.duration}}" min="0" placeholder="Tours" {{#unless ../canEdit}}disabled{{/unless}} />
        </div>
      {{/each}}
    </div>
  </section>

  <section class="bl-body-chart" aria-label="Membres">
    <h2 class="bl-ink-title">Membres</h2>
    <div class="bl-body-layout">
      <div class="bl-silhouette" aria-hidden="true">
        {{#each limbEntries as |entry|}}<span class="bl-limb-dot" data-limb="{{entry.key}}" data-status="{{entry.status}}"></span>{{/each}}
      </div>
      <div class="bl-limb-list">
        {{#each limbEntries as |entry|}}
          <div class="bl-limb" data-limb="{{entry.key}}" data-status="{{entry.status}}">
            <strong>{{entry.label}}</strong>
            <small>{{#if entry.thresholdPercent}}Seuil {{entry.thresholdPercent}} % des PV{{else}}Vital : arbitrage MJ{{/if}}{{#if entry.targetedDamage}} · subi {{entry.targetedDamage}}{{/if}}</small>
            <div class="bl-limb-toggles">
              <label><input type="checkbox" name="system.combat.injuries.limbs.{{entry.key}}.injured" data-dtype="Boolean" {{checked entry.state.injured}} {{#unless ../canEdit}}disabled{{/unless}} /> Blessé</label>
              <label><input type="checkbox" name="system.combat.injuries.limbs.{{entry.key}}.broken" data-dtype="Boolean" {{checked entry.state.broken}} {{#unless ../canEdit}}disabled{{/unless}} /> Cassé</label>
              <label><input type="checkbox" name="system.combat.injuries.limbs.{{entry.key}}.severed" data-dtype="Boolean" {{checked entry.state.severed}} {{#unless ../canEdit}}disabled{{/unless}} /> Sectionné</label>
            </div>
            {{#if ../showLimbNotes}}<textarea name="system.combat.injuries.limbs.{{entry.key}}.notes" rows="1" placeholder="Notes" aria-label="{{entry.label}} — notes" {{#unless ../canEdit}}disabled{{/unless}}>{{entry.state.notes}}</textarea>{{/if}}
          </div>
        {{/each}}
      </div>
    </div>
    {{#if system.combat.injuries.limbEffectSummary.length}}<small>{{join system.combat.injuries.limbEffectSummary ", "}}</small>{{/if}}
  </section>

  <section class="bl-death" aria-label="Mutilation et mort">
    <h2 class="bl-ink-title">Mort &amp; blessures graves</h2>
    <div class="bl-ledger-grid">
      <label class="bl-line"><span>État vital</span>
        <select name="system.death.state" {{#unless canEdit}}disabled{{/unless}}>
          {{#each deathStates as |st|}}<option value="{{st.value}}" {{#if (eq ../system.death.state st.value)}}selected{{/if}}>{{st.label}}</option>{{/each}}
        </select>
      </label>
      <label class="bl-line"><span>Blessures sévères</span>
        <input type="number" name="system.combat.injuries.severeWounds" value="{{system.combat.injuries.severeWounds}}" min="0" {{#unless canEdit}}disabled{{/unless}} />
      </label>
      <label class="bl-line"><span>Quasi mortelles</span>
        <input type="number" name="system.combat.injuries.nearDeathWounds" value="{{system.combat.injuries.nearDeathWounds}}" min="0" {{#unless canEdit}}disabled{{/unless}} />
      </label>
      <label class="bl-check"><input type="checkbox" name="system.death.standingDeath" data-dtype="Boolean" {{checked system.death.standingDeath}} {{#unless canEdit}}disabled{{/unless}} /> Mort debout</label>
    </div>
    <textarea class="bl-lined" name="system.death.deathNotes" rows="2" placeholder="Notes de mort, séquelles…" aria-label="Notes de mort" {{#unless canEdit}}disabled{{/unless}}>{{system.death.deathNotes}}</textarea>
  </section>
</div>
